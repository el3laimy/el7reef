          .hasOnly(['status', 'respondedAt', 'matchId']) &&
        (
          (
            request.resource.data.status == 'cancelled' &&
            resource.data.challengerId == request.auth.uid &&
            request.resource.data.matchId == resource.data.matchId
          ) ||
          (
            request.resource.data.status in ['declined', 'expired'] &&
            resource.data.challengedId == request.auth.uid &&
            request.resource.data.matchId == resource.data.matchId
          ) ||
          (
            request.resource.data.status == 'accepted' &&
            resource.data.challengedId == request.auth.uid &&
            request.resource.data.matchId == challengeId &&
            exists(/databases/$(database)/documents/matches/$(challengeId)) &&
            get(/databases/$(database)/documents/matches/$(challengeId))
              .data.challengeId == challengeId

          'teamAId',
          'teamBId',
          'teamAPlayerIds',
          'teamBPlayerIds',
          'teamAParticipantId',
          'teamBParticipantId',
          'status',
          'scoreTeamA',
          'scoreTeamB',
          'mvpPlayerId',
          'location',
          'latitude',
          'longitude',
          'teamSize',
          'isOrganized',
          'tournamentId',
          'challengeId',
          'isGoldenRating',
          'isAnomaly',
          'isFrozen',
          'stageType',
          'groupId',
          'groupStageId',
          'knockoutTieId',
          'roundIndex',
          'slotNumber',
          'scheduledAt',
          'publishedAt',
          'venueId',
          'fixtureStatus',
          'lineupRequirement',
          'createdAt',
          'startedAt',
          'completedAt',
          'cancelledAt',
          'cancelledBy',
          'cancelReason'

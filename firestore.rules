        validChallengeBackedMatchDoc(data) &&
        exists(/databases/$(database)/documents/challenges/$(data.challengeId)) &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.status == 'pending' &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.matchId == null &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.expiresAt > request.time &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.challengedId == request.auth.uid &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.challengerId == data.organizerId &&
        data.status == 'open' &&
        data.isOrganized == false &&
        data.tournamentId == null &&
        data.teamAPlayerIds is list &&
        data.teamBPlayerIds is list &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.challengerId in data.teamAPlayerIds &&
        request.auth.uid in data.teamBPlayerIds &&
        (
          !(get(/databases/$(database)/documents/challenges/$(data.challengeId))
            .data.challengerTeamId is string) ||
          data.teamAId == get(/databases/$(database)/documents/challenges/$(data.challengeId))
            .data.challengerTeamId
        ) &&
        (
          !(get(/databases/$(database)/documents/challenges/$(data.challengeId))
            .data.challengedTeamId is string) ||
          data.teamBId == get(/databases/$(database)/documents/challenges/$(data.challengeId))

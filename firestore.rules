    function canCreateReservedUsername(data, docId) {
      return isAuthenticated() &&
        data.keys().hasOnly([
          'username',
          'ownerId',
          'previousOwnerId',
          'status',
          'claimedAt',
          'reservedAt',
          'expiresAt'
        ]) &&
        data.username is string &&
        data.username == docId &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid;
    }

    function canClaimExpiredReservedUsername() {
      return resource.data.status == 'reserved' &&
        resource.data.expiresAt is int &&
        resource.data.expiresAt <= request.time.toMillis();
    }

    function canUpdateReservedUsername() {
      return isAuthenticated() &&
        (
          resource.data.ownerId == request.auth.uid ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
              'ownerId',
              'status',
              'claimedAt',
              'expiresAt'
            ]) &&
            request.resource.data.ownerId is string &&
            request.resource.data.ownerId == request.auth.uid &&
            request.resource.data.status == 'active' &&
            request.resource.data.claimedAt is int &&
            request.resource.data.expiresAt == null &&

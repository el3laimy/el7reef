rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isParticipant() {
      return request.auth.uid in resource.data.participants;
    }
    
    // ══════════════════════════════════════════
    // Phase 1–5: Core Collections
    // ══════════════════════════════════════════
    
    // ── Players ──
    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(playerId);
      allow update: if isOwner(playerId);
      allow delete: if false; // لا يمكن حذف الحساب
    }
    
    // ── Teams ──
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        resource.data.captainId == request.auth.uid;
      allow delete: if false;
    }
    
    // ── Matches ──
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
      
      // ── Player Stats (subcollection) ──
      match /player_stats/{playerId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if false;
      }
    }
    
    // ── Tournaments ──
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
      allow delete: if false;
    }
    
    // ── Rating Events (read-only for players) ──
    match /ratingEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-side only
    }
    
    // ── Encounter Logs ──
    match /encounterLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-side only
    }
    
    // ── Organizer Actions ──
    match /organizerActions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ══════════════════════════════════════════
    // Phase 6: Social & Identity
    // ══════════════════════════════════════════
    
    // ── Friendships ──
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // فقط المشاركون في الصداقة يقدروا يعدلوا (قبول/رفض/حظر)
      allow update: if isAuthenticated() && isParticipant();
      // فقط المشاركون يقدروا يحذفوا (إلغاء صداقة)
      allow delete: if isAuthenticated() && isParticipant();
    }

    // ── Reserved Usernames ──
    match /reservedUsernames/{username} {
      allow read: if isAuthenticated();
      // يتم التسجيل من الكود فقط عند اختيار username
      allow create: if isAuthenticated();
      allow update: if false; // لا يمكن تعديل username محجوز
      allow delete: if false;
    }

    // ══════════════════════════════════════════
    // Phase 7: Fan Voting
    // ══════════════════════════════════════════
    
    // ── Fan Voting Sessions ──
    match /fanVotingSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ── User Votes (تصويت واحد فقط لكل مستخدم) ──
    match /userVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false; // تصويت واحد فقط — لا تعديل
      allow delete: if false;
    }

    // ══════════════════════════════════════════
    // Phase 8: Fantasy League
    // ══════════════════════════════════════════
    
    // ── Fantasy Leagues ──
    match /fantasyLeagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }
    
    // ── Fantasy Teams ──
    match /fantasyTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // ── Fantasy Slots ──
    match /fantasySlots/{slotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ── Transfer Records (سجل غير قابل للتعديل) ──
    match /transferRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false; // سجل تاريخي — لا يُعدَّل
      allow delete: if false;
    }

    // ── Player Fantasy Values (حساب آلي) ──
    match /playerFantasyValues/{valueId} {
      allow read: if isAuthenticated();
      // يتم تحديثه بواسطة PlayerValueService فقط
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return isAuthenticated() && request.auth.uid in participants;
    }

    function isMatchOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function isMatchOrganizerById(matchId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId))
          .data.organizerId == request.auth.uid;
    }

    function isTournamentOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function hasActiveTournamentAssistant(tournamentId) {
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.status == 'active';
    }

    function canReadPrivateTournament(data, tournamentId) {
      return isAuthenticated() &&
        (
          data.organizerId == request.auth.uid ||
          hasActiveTournamentAssistant(tournamentId) ||
          (
            data.participantViewerIds is list &&
            request.auth.uid in data.participantViewerIds
          )
        );
    }

    function isPublicTournament(data) {
      return !data.keys().hasAny(['visibility']) ||
        data.visibility == 'public';
    }

    function validOptionalTournamentString(value, maxLength) {
      return value == null ||
        (value is string && value.size() <= maxLength);
    }

    function validOptionalTournamentInt(value, minValue, maxValue) {
      return value == null ||
        (value is int && value >= minValue && value <= maxValue);
    }

    function validTournamentDocument(data) {
      return data.keys().hasOnly([
          'organizerId',
          'name',
          'description',
          'location',
          'format',
          'teamSize',
          'maxTeams',
          'visibility',
          'discoverable',
          'isFeatured',
          'featuredPriority',
          'participantViewerIds',
          'prizePool',
          'prizeDescription',
          'status',
          'registeredTeamIds',
          'registeredTeamCount',
          'guestTeamCount',
          'approvedParticipantCount',
          'assistants',
          'groupRoundIds',
          'knockoutRoundIds',
          'isFantasyEnabled',
          'registrationDeadline',
          'startDate',
          'endDate',
          'participantListFinalizedAt',
          'activeParticipantCount',
          'currentGroupStageId',
          'currentKnockoutBracketId',
          'winnerParticipantId',
          'needsManualOpsMigration',
          'groupAdvancementConfig',
          'groupStandingsConfig',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'organizerId',
          'name',
          'format',
          'teamSize',
          'maxTeams',
          'status',
          'createdAt'
        ]) &&
        data.organizerId is string &&
        data.organizerId.size() > 0 &&
        data.organizerId.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        validOptionalTournamentString(data.get('description', null), 600) &&
        validOptionalTournamentString(data.get('location', null), 160) &&
        data.format in [
          'groups',
          'knockout',
          'groupsOnly',
          'knockoutOnly',
          'groupsThenKnockout'
        ] &&
        data.teamSize is int &&
        data.teamSize >= 5 &&
        data.teamSize <= 11 &&
        data.maxTeams is int &&
        data.maxTeams >= 2 &&
        data.maxTeams <= 128 &&
        data.get('visibility', 'public') in ['public', 'private', 'inviteOnly'] &&
        data.get('discoverable', true) is bool &&
        data.get('isFeatured', false) is bool &&
        data.get('featuredPriority', 1000) is int &&
        data.get('featuredPriority', 1000) >= 0 &&
        data.get('featuredPriority', 1000) <= 1000 &&
        data.get('participantViewerIds', []) is list &&
        data.get('participantViewerIds', []).size() <= 200 &&
        validOptionalTournamentInt(data.get('prizePool', null), 0, 1000000000) &&
        validOptionalTournamentString(data.get('prizeDescription', null), 300) &&
        data.status in [
          'upcoming',
          'registration',
          'groupStage',
          'transferWindow',
          'knockoutStage',
          'active',
          'completed',
          'cancelled'
        ] &&
        data.get('registeredTeamIds', []) is list &&
        data.get('registeredTeamIds', []).size() <= 128 &&
        validOptionalTournamentInt(data.get('registeredTeamCount', null), 0, 128) &&
        validOptionalTournamentInt(data.get('guestTeamCount', null), 0, 128) &&
        validOptionalTournamentInt(data.get('approvedParticipantCount', null), 0, 128) &&
        data.get('assistants', []) is list &&
        data.get('assistants', []).size() <= 20 &&
        data.get('groupRoundIds', []) is list &&
        data.get('groupRoundIds', []).size() <= 128 &&
        data.get('knockoutRoundIds', []) is list &&
        data.get('knockoutRoundIds', []).size() <= 128 &&
        data.get('isFantasyEnabled', false) is bool &&
        validOptionalTournamentInt(data.get('registrationDeadline', null), 0, 4102444800000) &&
        validOptionalTournamentInt(data.get('startDate', null), 0, 4102444800000) &&
        validOptionalTournamentInt(data.get('endDate', null), 0, 4102444800000) &&
        validOptionalTournamentInt(data.get('participantListFinalizedAt', null), 0, 4102444800000) &&
        validOptionalTournamentInt(data.get('activeParticipantCount', null), 0, 128) &&
        validOptionalTournamentString(data.get('currentGroupStageId', null), 160) &&
        validOptionalTournamentString(data.get('currentKnockoutBracketId', null), 160) &&
        validOptionalTournamentString(data.get('winnerParticipantId', null), 160) &&
        data.get('needsManualOpsMigration', false) is bool &&
        (
          !data.keys().hasAny(['groupAdvancementConfig']) ||
          (
            data.groupAdvancementConfig is map &&
            data.groupAdvancementConfig.keys().hasOnly([
              'groupCount',
              'automaticQualifiersPerGroup',
              'bestRankedAdditionalQualifiers'
            ]) &&
            validOptionalTournamentInt(
              data.groupAdvancementConfig.get('groupCount', null),
              1,
              32
            ) &&
            data.groupAdvancementConfig.automaticQualifiersPerGroup is int &&
            data.groupAdvancementConfig.automaticQualifiersPerGroup >= 1 &&
            data.groupAdvancementConfig.automaticQualifiersPerGroup <= 16 &&
            data.groupAdvancementConfig.bestRankedAdditionalQualifiers is int &&
            data.groupAdvancementConfig.bestRankedAdditionalQualifiers >= 0 &&
            data.groupAdvancementConfig.bestRankedAdditionalQualifiers <= 64
          )
        ) &&
        (
          !data.keys().hasAny(['groupStandingsConfig']) ||
          (
            data.groupStandingsConfig is map &&
            data.groupStandingsConfig.keys().hasOnly(['tiebreakerOrder']) &&
            data.groupStandingsConfig.tiebreakerOrder is list &&
            data.groupStandingsConfig.tiebreakerOrder.size() >= 1 &&
            data.groupStandingsConfig.tiebreakerOrder.size() <= 4
          )
        ) &&
        data.createdAt is int &&
        data.createdAt >= 0 &&
        data.createdAt <= 4102444800000 &&
        validOptionalTournamentInt(data.get('updatedAt', null), 0, 4102444800000);
    }

    function createsUnfeaturedTournament(data) {
      return data.get('isFeatured', false) == false &&
        data.get('featuredPriority', 1000) == 1000;
    }

    function preservesTournamentAuthorityAndPromotion() {
      return request.resource.data.organizerId == resource.data.organizerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.get('isFeatured', false) ==
          resource.data.get('isFeatured', false) &&
        request.resource.data.get('featuredPriority', 1000) ==
          resource.data.get('featuredPriority', 1000);
    }

    function canListTournament(data) {
      return isAuthenticated() &&
        data.keys().hasAll(['visibility', 'discoverable']) &&
        data.visibility == 'public' &&
        data.discoverable == true;
    }

    function ownsTeamById(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId))
          .data.ownerId == request.auth.uid;
    }

    function canManageTeamById(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        (
          get(/databases/$(database)/documents/teams/$(teamId))
            .data.ownerId == request.auth.uid ||
          request.auth.uid in
            get(/databases/$(database)/documents/teams/$(teamId))
              .data.viceCaptainIds
        );
    }

    function organizesTournamentById(tournamentId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId))
          .data.organizerId == request.auth.uid;
    }

    function canManageGuestPlayer(data) {
      return isAuthenticated() && (
        (data.createdBy is string && data.createdBy == request.auth.uid) ||
        (data.teamId is string && canManageTeamById(data.teamId)) ||
        (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId)) ||
        (data.tournamentId is string && organizesTournamentById(data.tournamentId)) ||
        (
          data.guestTeamId is string &&
          data.tournamentId is string &&
          hasGuestRosterAssistantPermissionForGuestTeam(
            data.guestTeamId,
            data.tournamentId
          )
        )
      );
    }

    function isLinkedGuestPlayer(data) {
      return isAuthenticated() &&
        data.linkedPlayerId is string &&
        data.linkedPlayerId == request.auth.uid;
    }

    function canCreateGuestPlayer(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        data.get('linkedPlayerId', null) == null &&
        (
          (data.teamId is string && canManageTeamById(data.teamId)) ||
          (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId)) ||
          (data.tournamentId is string && organizesTournamentById(data.tournamentId)) ||
          (
            data.guestTeamId is string &&
            data.tournamentId is string &&
            hasGuestRosterAssistantPermissionForGuestTeam(
              data.guestTeamId,
              data.tournamentId
            )
          )
        );
    }

    function canManageGuestTeam(data) {
      return isAuthenticated() &&
        data.creatorId is string &&
        data.creatorId == request.auth.uid;
    }

    function canUpdateGuestTeamRosterCaptain(guestTeamId) {
      return isAuthenticated() &&
        resource.data.tournamentIds is list &&
        (
          canReadGuestTeamByTournamentIds(resource.data.tournamentIds) ||
          canManageGuestRosterByTournamentIds(resource.data.tournamentIds)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['captainGuestPlayerId', 'updatedAt']) &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.tournamentIds == resource.data.tournamentIds &&
        request.resource.data.updatedAt is int &&
        (
          request.resource.data.captainGuestPlayerId == null ||
          (
            request.resource.data.captainGuestPlayerId is string &&
            exists(
              /databases/$(database)/documents/guestPlayers/$(request.resource.data.captainGuestPlayerId)
            ) &&
            get(
              /databases/$(database)/documents/guestPlayers/$(request.resource.data.captainGuestPlayerId)
            ).data.guestTeamId == guestTeamId &&
            get(
              /databases/$(database)/documents/guestPlayers/$(request.resource.data.captainGuestPlayerId)
            ).data.claimStatus != 'archived'
          )
        );
    }

    function canReadGuestTeam(data) {
      return isAuthenticated() &&
        (
          (data.creatorId is string && data.creatorId == request.auth.uid) ||
          (
            data.tournamentIds is list &&
            'world-cup-2026-simulation' in data.tournamentIds
          ) ||
          canReadGuestTeamByTournamentIds(data.tournamentIds) ||
          canManageGuestRosterByTournamentIds(data.tournamentIds)
        );
    }

    function canReadGuestTeamByTournamentIds(tournamentIds) {
      return tournamentIds is list &&
        (
          (
            tournamentIds.size() > 0 &&
            tournamentIds[0] is string &&
            organizesTournamentById(tournamentIds[0])
          ) ||
          (
            tournamentIds.size() > 1 &&
            tournamentIds[1] is string &&
            organizesTournamentById(tournamentIds[1])
          ) ||
          (
            tournamentIds.size() > 2 &&
            tournamentIds[2] is string &&
            organizesTournamentById(tournamentIds[2])
          ) ||
          (
            tournamentIds.size() > 3 &&
            tournamentIds[3] is string &&
            organizesTournamentById(tournamentIds[3])
          ) ||
          (
            tournamentIds.size() > 4 &&
            tournamentIds[4] is string &&
            organizesTournamentById(tournamentIds[4])
          )
        );
    }

    function canManageGuestRosterByTournamentIds(tournamentIds) {
      return tournamentIds is list &&
        (
          (
            tournamentIds.size() > 0 &&
            tournamentIds[0] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[0],
              'canManageGuestRoster'
            )
          ) ||
          (
            tournamentIds.size() > 1 &&
            tournamentIds[1] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[1],
              'canManageGuestRoster'
            )
          ) ||
          (
            tournamentIds.size() > 2 &&
            tournamentIds[2] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[2],
              'canManageGuestRoster'
            )
          ) ||
          (
            tournamentIds.size() > 3 &&
            tournamentIds[3] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[3],
              'canManageGuestRoster'
            )
          ) ||
          (
            tournamentIds.size() > 4 &&
            tournamentIds[4] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[4],
              'canManageGuestRoster'
            )
          )
        );
    }

    function hasGuestRosterAssistantPermissionForGuestTeam(
      guestTeamId,
      tournamentId
    ) {
      return isAuthenticated() &&
        guestTeamId is string &&
        tournamentId is string &&
        exists(/databases/$(database)/documents/guestTeams/$(guestTeamId)) &&
        get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
          .data.tournamentIds is list &&
        tournamentId in
          get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
            .data.tournamentIds &&
        hasActiveTournamentAssistantPermission(
          tournamentId,
          'canManageGuestRoster'
        );
    }

    function ownsGuestTeamById(guestTeamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/guestTeams/$(guestTeamId)) &&
        get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
          .data.creatorId == request.auth.uid;
    }

    function canCreateTournamentRegistration(data) {
      return isAuthenticated() &&
        data.tournamentId is string &&
        data.createdBy == request.auth.uid &&
        (
          (
            organizesTournamentById(data.tournamentId) &&
            data.status in ['pending', 'approved', 'rejected'] &&
            (
              data.status == 'pending' ||
              hasOrganizerDecisionByCurrentUser(data)
            )
          ) ||
          (
            ownsTournamentRegistrationSource(data) &&
            data.status == 'pending' &&
            hasNoOrganizerDecisionValues(data)
          )
        );
    }

    function ownsTournamentRegistrationSource(data) {
      return isAuthenticated() && (
        (data.teamId is string && ownsTeamById(data.teamId)) ||
        (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId))
      );
    }

    function hasNoOrganizerDecisionValues(data) {
      return (
          !data.keys().hasAny(['verifiedBy']) ||
          data.verifiedBy == null
        ) &&
        (
          !data.keys().hasAny(['verifiedAt']) ||
          data.verifiedAt == null
        ) &&
        (
          !data.keys().hasAny(['reviewedBy']) ||
          data.reviewedBy == null
        ) &&
        (
          !data.keys().hasAny(['reviewedAt']) ||
          data.reviewedAt == null
        ) &&
        (
          !data.keys().hasAny(['reviewerId']) ||
          data.reviewerId == null
        ) &&
        (
          !data.keys().hasAny(['rejectionReason']) ||
          data.rejectionReason == null
        ) &&
        (
          !data.keys().hasAny(['organizerNote']) ||
          data.organizerNote == null
        );
    }

    function hasOrganizerDecisionByCurrentUser(data) {
      return data.verifiedBy == request.auth.uid &&
        data.verifiedAt is int;
    }

    function registrationImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'tournamentId',
          'teamId',
          'guestTeamId',
          'claimedFromGuestTeamId',
          'createdBy',
          'submittedBy',
          'createdAt',
          'sourceId',
          'sourceType'
        ]);
    }

    function canSubmitterUpdatePendingTournamentRegistration() {
      return ownsTournamentRegistrationSource(resource.data) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == resource.data.status &&
        registrationImmutableFieldsUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mode', 'notes', 'updatedAt']);
    }

    function canOrganizerDecideTournamentRegistration() {
      return organizesTournamentById(resource.data.tournamentId) &&
        registrationImmutableFieldsUnchanged() &&
        request.resource.data.status in ['approved', 'rejected'] &&
        hasOrganizerDecisionByCurrentUser(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'verifiedBy',
            'verifiedAt',
            'reviewedBy',
            'reviewedAt',
            'reviewerId',
            'rejectionReason',
            'organizerNote',
            'notes',
            'updatedAt'
          ]);
    }

    function canUpdateTournamentRegistration() {
      return isAuthenticated() &&
        resource.data.tournamentId is string &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        (
          canOrganizerDecideTournamentRegistration() ||
          canSubmitterUpdatePendingTournamentRegistration()
        );
    }

    function canReadTournamentRegistration(data) {
      return isAuthenticated() &&
        data.tournamentId is string &&
        (
          data.status == 'approved' ||
          organizesTournamentById(data.tournamentId) ||
          ownsTournamentRegistrationSource(data) ||
          data.createdBy == request.auth.uid
        );
    }

    function canManageMatchdaySide(data) {
      return isAuthenticated() &&
        data.matchId is string &&
        (
          hasActiveAssistantPermissionForMatch(data.matchId, 'canStartMatch') ||
          (
            data.teamId is string &&
            (
              canManageTeamById(data.teamId) ||
              isMatchOrganizerById(data.matchId)
            )
          ) ||
          (
            data.guestTeamId is string &&
            (
              ownsGuestTeamById(data.guestTeamId) ||
              isMatchOrganizerById(data.matchId)
            )
          )
        );
    }

    function canUnlockLineupSnapshot(data) {
      return isAuthenticated() &&
        data.matchId is string &&
        exists(/databases/$(database)/documents/matches/$(data.matchId)) &&
        get(/databases/$(database)/documents/matches/$(data.matchId))
          .data.status in ['open', 'full'] &&
        get(/databases/$(database)/documents/matches/$(data.matchId))
          .data.isFrozen != true &&
        (
          isMatchOrganizerById(data.matchId) ||
          hasActiveAssistantPermissionForMatch(data.matchId, 'canStartMatch')
        );
    }

    function canCreateClaimCode(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        (
          (
            data.targetType == 'guestPlayer' &&
            data.targetId is string &&
            exists(/databases/$(database)/documents/guestPlayers/$(data.targetId)) &&
            canManageGuestPlayer(
              get(/databases/$(database)/documents/guestPlayers/$(data.targetId)).data
            )
          ) ||
          (
            data.targetType == 'guestTeam' &&
            data.targetId is string &&
            exists(/databases/$(database)/documents/guestTeams/$(data.targetId)) &&
            canManageGuestTeam(
              get(/databases/$(database)/documents/guestTeams/$(data.targetId)).data
            )
          ) ||
          (
            data.targetType == 'teamInvite' &&
            data.teamId is string &&
            data.targetId == data.teamId &&
            canManageTeamById(data.teamId)
          )
        );
    }

    function isActiveGuestPlayerClaimCode(claimCode, guestPlayerId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestPlayer' &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestPlayerId &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'active' &&
        (
          !(get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt is int) ||
          get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt > request.time.toMillis()
        );
    }

    function isActiveGuestTeamClaimCode(claimCode, guestTeamId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestTeam' &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestTeamId &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'active' &&
        (
          !(get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt is int) ||
          get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt > request.time.toMillis()
        );
    }

    function hasSameBatchGuestPlayerClaimProof(claimCode, guestPlayerId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestPlayer' &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestPlayerId &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'claimed' &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.claimedByPlayerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.claimedAt is int &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.updatedAt is int;
    }

    function hasSameBatchGuestTeamClaimProof(claimCode, guestTeamId, teamId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestTeam' &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestTeamId &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'claimed' &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.claimedByPlayerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.teamId == teamId &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.claimedAt is int &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.updatedAt is int;
    }

    function canSelfClaimGuestPlayer(guestPlayerId) {
      return isAuthenticated() &&
        resource.data.claimCode is string &&
        isActiveGuestPlayerClaimCode(resource.data.claimCode, guestPlayerId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'claimStatus',
            'linkedPlayerId',
            'updatedAt'
          ]) &&
        request.resource.data.updatedAt is int &&
        request.resource.data.displayName == resource.data.displayName &&
        request.resource.data.normalizedName == resource.data.normalizedName &&
        request.resource.data.phoneNumber == resource.data.phoneNumber &&
        request.resource.data.jerseyNumber == resource.data.jerseyNumber &&
        request.resource.data.preferredPosition == resource.data.preferredPosition &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.claimCode == resource.data.claimCode &&
        request.resource.data.notes == resource.data.notes &&
        request.resource.data.claimStatus == 'claimed' &&
        request.resource.data.linkedPlayerId == request.auth.uid &&
        hasSameBatchGuestPlayerClaimProof(
          resource.data.claimCode,
          guestPlayerId
        );
    }

    function canSelfClaimGuestTeam(guestTeamId) {
      return isAuthenticated() &&
        resource.data.claimCode is string &&
        isActiveGuestTeamClaimCode(resource.data.claimCode, guestTeamId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'claimStatus',
            'linkedTeamId',
            'updatedAt'
          ]) &&
        request.resource.data.updatedAt is int &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.normalizedName == resource.data.normalizedName &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.contactName == resource.data.contactName &&
        request.resource.data.contactPhone == resource.data.contactPhone &&
        request.resource.data.logoUrl == resource.data.logoUrl &&
        request.resource.data.tournamentIds == resource.data.tournamentIds &&
        request.resource.data.captainGuestPlayerId == resource.data.captainGuestPlayerId &&
        request.resource.data.claimCode == resource.data.claimCode &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.claimStatus == 'claimed' &&
        request.resource.data.linkedTeamId is string &&
        ownsTeamById(request.resource.data.linkedTeamId) &&
        hasSameBatchGuestTeamClaimProof(
          resource.data.claimCode,
          guestTeamId,
          request.resource.data.linkedTeamId
        );
    }

    function canFinalizeGuestPlayerClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestPlayer' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'claimedByPlayerId',
            'claimedAt',
            'updatedAt'
          ]) &&
        request.resource.data.claimedAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedByPlayerId == request.auth.uid;
    }

    function canRequestGuestTeamClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestTeam' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.status == 'active' &&
        request.resource.data.claimedAt == resource.data.claimedAt &&
        request.resource.data.claimedByPlayerId == request.auth.uid &&
        request.resource.data.teamId is string &&
        ownsTeamById(request.resource.data.teamId) &&
        (
          !(resource.data.teamId is string) ||
          resource.data.teamId == request.resource.data.teamId
        ) &&
        (
          !(resource.data.claimedByPlayerId is string) ||
          resource.data.claimedByPlayerId == request.auth.uid
        );
    }

    function canFinalizeGuestTeamClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestTeam' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'teamId',
            'status',
            'claimedByPlayerId',
            'claimedAt',
            'updatedAt'
          ]) &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.teamId is string &&
        (
          (
            ownsTeamById(request.resource.data.teamId) &&
            request.resource.data.claimedByPlayerId == request.auth.uid
          ) ||
          (
            resource.data.createdBy == request.auth.uid &&
            resource.data.teamId is string &&
            resource.data.teamId == request.resource.data.teamId &&
            resource.data.claimedByPlayerId is string &&
            request.resource.data.claimedByPlayerId == resource.data.claimedByPlayerId
          )
        );
    }

    function canSelfClaimMembership() {
      return isAuthenticated() &&
        resource.data.guestPlayerId is string &&
        isActiveGuestPlayerClaimCode(
          get(/databases/$(database)/documents/guestPlayers/$(resource.data.guestPlayerId))
            .data.claimCode,
          resource.data.guestPlayerId
        ) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.playerId == request.auth.uid &&
        request.resource.data.guestPlayerId == null &&
        request.resource.data.claimedFromGuestPlayerId == resource.data.guestPlayerId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.availability == resource.data.availability &&
        request.resource.data.joinedAt == resource.data.joinedAt &&
        request.resource.data.invitedBy == resource.data.invitedBy;
    }

    function canUpdateClaimCode(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.createdBy == resource.data.createdBy;
    }

    function ownsFantasyTeam(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/fantasyTeams/$(teamId)) &&
        get(/databases/$(database)/documents/fantasyTeams/$(teamId))
          .data.ownerPlayerId == request.auth.uid;
    }

    function nullableString(data, key) {
      return data.get(key, null) == null || data.get(key, null) is string;
    }

    function nullableInt(data, key) {
      return data.get(key, null) == null || data.get(key, null) is int;
    }

    function isBoundedDocumentId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    // Firestore Rules cannot iterate over lists, so inspect every supported
    // knockout slot explicitly. Larger brackets must be persisted through a
    // trusted backend operation instead of weakening client-side validation.
    function isBoundedDocumentIdList(value, minSize, maxSize) {
      return value is list &&
        value.size() >= minSize &&
        value.size() <= maxSize &&
        (value.size() <= 0 || isBoundedDocumentId(value[0])) &&
        (value.size() <= 1 || isBoundedDocumentId(value[1])) &&
        (value.size() <= 2 || isBoundedDocumentId(value[2])) &&
        (value.size() <= 3 || isBoundedDocumentId(value[3])) &&
        (value.size() <= 4 || isBoundedDocumentId(value[4])) &&
        (value.size() <= 5 || isBoundedDocumentId(value[5])) &&
        (value.size() <= 6 || isBoundedDocumentId(value[6])) &&
        (value.size() <= 7 || isBoundedDocumentId(value[7])) &&
        (value.size() <= 8 || isBoundedDocumentId(value[8])) &&
        (value.size() <= 9 || isBoundedDocumentId(value[9])) &&
        (value.size() <= 10 || isBoundedDocumentId(value[10])) &&
        (value.size() <= 11 || isBoundedDocumentId(value[11])) &&
        (value.size() <= 12 || isBoundedDocumentId(value[12])) &&
        (value.size() <= 13 || isBoundedDocumentId(value[13])) &&
        (value.size() <= 14 || isBoundedDocumentId(value[14])) &&
        (value.size() <= 15 || isBoundedDocumentId(value[15]));
    }

    function isAllowedAnalyticsCardType(value) {
      return value in [
        'matchResult',
        'mvp',
        'topScorers',
        'lineup',
        'champion',
        'player',
        'team',
        'tournamentInvite',
        'upcomingFixture',
        'goalScorer',
        'qualification',
        'groupStandings',
        'knockoutBracket',
        'playerMilestone'
      ];
    }

    function isAllowedAnalyticsEntityType(value) {
      return value in [
        'match',
        'player',
        'guestPlayer',
        'team',
        'tournament',
        'lineup'
      ];
    }

    function isValidAnalyticsCampaignSource(value) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= 64 &&
        value.matches('^[a-z0-9][a-z0-9_-]{0,63}$');
    }

    function isValidPrideAnalyticsParameters(parameters) {
      return parameters is map &&
        parameters.keys().hasAll([
          'cardType',
          'entityType',
          'entityId',
          'campaignSource',
          'schemaVersion'
        ]) &&
        parameters.keys().hasOnly([
          'cardType',
          'entityType',
          'entityId',
          'tournamentId',
          'matchId',
          'campaignSource',
          'schemaVersion'
        ]) &&
        isAllowedAnalyticsCardType(parameters.cardType) &&
        isAllowedAnalyticsEntityType(parameters.entityType) &&
        isBoundedDocumentId(parameters.entityId) &&
        (
          !parameters.keys().hasAny(['tournamentId']) ||
          isBoundedDocumentId(parameters.tournamentId)
        ) &&
        (
          !parameters.keys().hasAny(['matchId']) ||
          isBoundedDocumentId(parameters.matchId)
        ) &&
        isValidAnalyticsCampaignSource(parameters.campaignSource) &&
        parameters.schemaVersion is int &&
        parameters.schemaVersion == 1;
    }

    function isValidPrideAnalyticsEvent(data) {
      return data.keys().hasOnly(['eventName', 'parameters', 'createdAt']) &&
        data.eventName in [
          'pride_card_viewed',
          'share_started',
          'share_sheet_returned',
          'share_link_opened',
          'claim_started_from_card',
          'claim_completed_from_card'
        ] &&
        isValidPrideAnalyticsParameters(data.parameters);
    }

    function isValidPrideExportParameters(parameters) {
      return parameters is map &&
        parameters.keys().hasAll([
          'cardType',
          'format',
          'mediaType',
          'exportDurationMs',
          'fallbackUsed'
        ]) &&
        parameters.keys().hasOnly([
          'cardType',
          'format',
          'mediaType',
          'exportDurationMs',
          'fallbackUsed',
          'failureCode'
        ]) &&
        isAllowedAnalyticsCardType(parameters.cardType) &&
        parameters.format in [
          'square1x1',
          'feed4x5',
          'story9x16',
          'landscape16x9'
        ] &&
        parameters.mediaType in ['image', 'video'] &&
        parameters.exportDurationMs is int &&
        parameters.exportDurationMs >= 0 &&
        parameters.exportDurationMs <= 600000 &&
        parameters.fallbackUsed is bool &&
        (
          !parameters.keys().hasAny(['failureCode']) ||
          (
            parameters.failureCode is string &&
            parameters.failureCode.size() > 0 &&
            parameters.failureCode.size() <= 64 &&
            parameters.failureCode.matches('^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$')
          )
        );
    }

    function isValidPrideExportAnalyticsEvent(data) {
      return data.keys().hasOnly(['eventName', 'parameters', 'createdAt']) &&
        data.eventName == 'pride_export_finished' &&
        isValidPrideExportParameters(data.parameters);
    }

    function isAllowedLegacyAnalyticsType(eventName, type) {
      return (
          eventName == 'invite_sent' &&
          type in ['guest_player', 'guest_team', 'team_invite']
        ) ||
        (
          eventName == 'claim_open' &&
          type in ['guestPlayer', 'guestTeam', 'teamInvite', 'team_invite']
        ) ||
        (
          eventName == 'claim_completion' &&
          type in ['guest_player', 'guest_team']
        ) ||
        (
          eventName == 'join_completion' &&
          type == 'team_invite'
        );
    }

    function isValidLegacyAnalyticsParameters(data) {
      let requiresActor = data.eventName in [
        'invite_sent',
        'claim_completion',
        'join_completion'
      ];
      return data.parameters is map &&
        data.parameters.keys().hasAll(['type', 'targetId']) &&
        data.parameters.keys().hasOnly(
          requiresActor
            ? ['type', 'targetId', 'actorId']
            : ['type', 'targetId']
        ) &&
        isAllowedLegacyAnalyticsType(
          data.eventName,
          data.parameters.type
        ) &&
        isBoundedDocumentId(data.parameters.targetId) &&
        (
          !requiresActor ||
          (
            data.parameters.keys().hasAll(['actorId']) &&
            data.parameters.actorId == request.auth.uid &&
            isBoundedDocumentId(data.parameters.actorId)
          )
        );
    }

    function isValidLegacyAnalyticsEvent(data) {
      let requiresActor = data.eventName in [
        'invite_sent',
        'claim_completion',
        'join_completion'
      ];
      return data.eventName in [
          'invite_sent',
          'claim_open',
          'claim_completion',
          'join_completion'
        ] &&
        data.keys().hasOnly(
          requiresActor
            ? ['eventName', 'actorId', 'parameters', 'createdAt']
            : ['eventName', 'parameters', 'createdAt']
        ) &&
        (
          !requiresActor ||
          (
            data.keys().hasAll(['actorId']) &&
            data.actorId == request.auth.uid &&
            isBoundedDocumentId(data.actorId)
          )
        ) &&
        isValidLegacyAnalyticsParameters(data);
    }

    function isValidAnalyticsEvent(data) {
      return isAuthenticated() &&
        data.keys().hasAll(['eventName', 'parameters', 'createdAt']) &&
        data.eventName is string &&
        data.createdAt is int &&
        data.createdAt >= 0 &&
        data.createdAt <= request.time.toMillis() + 300000 &&
        (
          isValidLegacyAnalyticsEvent(data) ||
          isValidPrideAnalyticsEvent(data) ||
          isValidPrideExportAnalyticsEvent(data)
        );
    }

    function clientMatchDecisionFieldsAreUnset(data) {
      return data.get('penaltyScoreTeamA', null) == null &&
        data.get('penaltyScoreTeamB', null) == null &&
        data.get('knockoutDecision', null) == null;
    }

    function clientMatchDecisionFieldsAreUnchanged() {
      return request.resource.data.get('penaltyScoreTeamA', null) ==
          resource.data.get('penaltyScoreTeamA', null) &&
        request.resource.data.get('penaltyScoreTeamB', null) ==
          resource.data.get('penaltyScoreTeamB', null) &&
        request.resource.data.get('knockoutDecision', null) ==
          resource.data.get('knockoutDecision', null);
    }

    function isAllowedAssistantPermissionName(permissionName) {
      return permissionName in [
        'canViewMatchday',
        'canStartMatch',
        'canSubmitScore',
        'canRecordGoalsAndMvp',
        'canApproveScore',
        'canDeclareForfeit',
        'canManageGuestRoster'
      ];
    }

    function hasActiveTournamentAssistantPermission(tournamentId, permissionName) {
      return isAuthenticated() &&
        isAllowedAssistantPermissionName(permissionName) &&
        exists(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.status == 'active' &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.permissions is map &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.permissions.get(permissionName, false) == true;
    }

    function hasActiveAssistantPermissionForMatch(matchId, permissionName) {
      return isAuthenticated() &&
        matchId is string &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId))
          .data.tournamentId is string &&
        hasActiveTournamentAssistantPermission(
          get(/databases/$(database)/documents/matches/$(matchId))
            .data.tournamentId,
          permissionName
        );
    }

    function isAssistantLineupSnapshotIdUpdate(matchId) {
      return hasActiveAssistantPermissionForMatch(matchId, 'canStartMatch') &&
        resource.data.status in ['open', 'full'] &&
        resource.data.isFrozen != true &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'lineupSnapshotIds',
            'guestLineupSnapshotIds',
            'matchSideLineupSnapshotIds'
          ]) &&
        request.resource.data.get('lineupSnapshotIds', {}) is map &&
        request.resource.data.get('guestLineupSnapshotIds', {}) is map &&
        request.resource.data.get('matchSideLineupSnapshotIds', {}) is map;
    }

    function isOrganizerSafeMatchUpdate() {
      return isMatchOrganizer() &&
        clientMatchDecisionFieldsAreUnchanged() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'scoreTeamA',
            'scoreTeamB',
            'penaltyScoreTeamA',
            'penaltyScoreTeamB',
            'knockoutDecision',
            'mvpPlayerId',
            'prideEventsPending',
            'completedAt',
            'isAnomaly',
            'ratingsAppliedAt'
          ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status']) ||
          request.resource.data.status in [
            'open',
            'full',
            'live',
            'cancelled',
            'frozen'
          ]
        );
    }

    function canReadAuditEvent(data) {
      return isAuthenticated() &&
        (
          data.actorId == request.auth.uid ||
          (
            data.entityType == 'tournament' &&
            data.entityId is string &&
            organizesTournamentById(data.entityId)
          ) ||
          (
            data.entityType == 'match' &&
            data.entityId is string &&
            isMatchOrganizerById(data.entityId)
          ) ||
          (
            data.entityType == 'team' &&
            data.entityId is string &&
            canManageTeamById(data.entityId)
          ) ||
          (
            data.entityType == 'registration' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/tournamentRegistrations/$(data.entityId)) &&
            canReadTournamentRegistration(
              get(/databases/$(database)/documents/tournamentRegistrations/$(data.entityId)).data
            )
          ) ||
          (
            data.entityType == 'tournamentParticipant' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/tournamentParticipants/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/tournamentParticipants/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.entityType == 'tournamentGroup' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/tournamentGroups/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/tournamentGroups/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.entityType == 'groupStandingSnapshot' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/groupStandingSnapshots/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/groupStandingSnapshots/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.entityType == 'knockoutBracket' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/knockoutBrackets/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/knockoutBrackets/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.entityType == 'knockoutTie' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/knockoutTies/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/knockoutTies/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.metadata is map &&
            data.metadata.tournamentId is string &&
            organizesTournamentById(data.metadata.tournamentId)
          ) ||
          (
            data.metadata is map &&
            data.metadata.matchId is string &&
            isMatchOrganizerById(data.metadata.matchId)
          )
        );
    }

    function validAssistantPermissionMap(permissions) {
      return permissions is map &&
        permissions.keys().hasOnly([
          'canViewMatchday',
          'canStartMatch',
          'canSubmitScore',
          'canRecordGoalsAndMvp',
          'canApproveScore',
          'canDeclareForfeit',
          'canManageGuestRoster'
        ]) &&
        permissions.keys().hasAll([
          'canViewMatchday',
          'canStartMatch',
          'canSubmitScore',
          'canRecordGoalsAndMvp',
          'canApproveScore',
          'canDeclareForfeit',
          'canManageGuestRoster'
        ]) &&
        permissions.canViewMatchday is bool &&
        permissions.canStartMatch is bool &&
        permissions.canSubmitScore is bool &&
        permissions.canRecordGoalsAndMvp is bool &&
        permissions.canApproveScore is bool &&
        permissions.canDeclareForfeit is bool &&
        permissions.canManageGuestRoster is bool;
    }

    function validAssistantPermissionLifecycle(data) {
      return data.status in ['active', 'revoked'] &&
        (
          (
            data.status == 'active' &&
            data.revokedAt == null
          ) ||
          (
            data.status == 'revoked' &&
            data.revokedAt is int
          )
        );
    }

    function validAssistantPermissionDoc(data, tournamentId, assistantUserId) {
      return data.keys().hasOnly([
          'tournamentId',
          'userId',
          'addedBy',
          'status',
          'preset',
          'permissions',
          'createdAt',
          'updatedAt',
          'revokedAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'userId',
          'addedBy',
          'status',
          'preset',
          'permissions',
          'createdAt',
          'updatedAt',
          'revokedAt'
        ]) &&
        data.tournamentId == tournamentId &&
        data.userId == assistantUserId &&
        data.addedBy is string &&
        data.preset in [
          'resultsAssistant',
          'matchdayAssistant',
          'scoreApprover',
          'customLimited'
        ] &&
        data.createdAt is int &&
        data.updatedAt is int &&
        validAssistantPermissionLifecycle(data) &&
        validAssistantPermissionMap(data.permissions);
    }

    function assistantPermissionIdentityUnchanged() {
      return request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.addedBy == resource.data.addedBy &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function canCreateAssistantPermission(tournamentId, assistantUserId) {
      return organizesTournamentById(tournamentId) &&
        assistantUserId != request.auth.uid &&
        validAssistantPermissionDoc(
          request.resource.data,
          tournamentId,
          assistantUserId
        ) &&
        request.resource.data.addedBy == request.auth.uid;
    }

    function canUpdateAssistantPermission(tournamentId, assistantUserId) {
      return organizesTournamentById(tournamentId) &&
        resource.data.tournamentId == tournamentId &&
        resource.data.userId == assistantUserId &&
        validAssistantPermissionDoc(
          request.resource.data,
          tournamentId,
          assistantUserId
        ) &&
        assistantPermissionIdentityUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'preset',
            'permissions',
            'updatedAt',
            'revokedAt'
          ]);
    }

    function canGetAssistantPermission(tournamentId, assistantUserId) {
      return organizesTournamentById(tournamentId) || isOwner(assistantUserId);
    }

    function validTournamentFollower(data, tournamentId, followerUserId) {
      return data.keys().hasOnly([
          'tournamentId',
          'userId',
          'createdAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'userId',
          'createdAt'
        ]) &&
        data.tournamentId == tournamentId &&
        data.userId == followerUserId &&
        data.createdAt is int;
    }

    function validOrganizerTournamentMembership(data, membershipId) {
      return data.keys().hasOnly([
          'tournamentId',
          'userId',
          'role',
          'createdAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'userId',
          'role',
          'createdAt'
        ]) &&
        isBoundedDocumentId(data.tournamentId) &&
        data.userId == request.auth.uid &&
        data.role == 'organizer' &&
        data.createdAt is int &&
        data.createdAt > 0 &&
        membershipId == request.auth.uid + '_' + data.tournamentId &&
        getAfter(
          /databases/$(database)/documents/tournaments/$(data.tournamentId)
        ).data.organizerId == request.auth.uid;
    }

    function hasMatchingOrganizerMembershipAfter(tournamentId) {
      let membershipId = request.auth.uid + '_' + tournamentId;
      let membership = getAfter(
          /databases/$(database)/documents/tournamentMemberships/$(membershipId)
        ).data;
      return membership.tournamentId == tournamentId &&
        membership.userId == request.auth.uid &&
        membership.role == 'organizer';

          'status',
          'message',
          'location',
          'teamSize',
          'createdAt',
          'respondedAt',
          'expiresAt'
        ]) &&
        data.keys().hasAll([
          'challengerId',
          'challengedId',
          'status',
          'teamSize',
          'createdAt',
          'expiresAt'
        ]) &&
        data.challengerId is string &&
        data.challengedId is string &&
        data.challengerId != data.challengedId &&
        isOptionalString(data.challengerTeamId) &&
        isOptionalString(data.challengedTeamId) &&
        isOptionalString(data.matchId) &&
        data.status in ['pending', 'accepted', 'declined', 'expired', 'cancelled'] &&
        data.teamSize is int &&
        data.teamSize >= 5 &&
        data.teamSize <= 11 &&
        data.createdAt is timestamp &&
        isOptionalTimestamp(data.respondedAt) &&
        data.expiresAt is timestamp &&
        data.expiresAt > data.createdAt &&

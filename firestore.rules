          'status',
          'createdAt',
          'respondedAt'
        ]) &&
        data.keys().hasAll([
          'matchId',
          'senderId',
          'receiverId',
          'side',
          'status',
          'createdAt'
        ]) &&
        data.matchId is string &&
        data.senderId is string &&
        data.receiverId is string &&
        data.senderId != data.receiverId &&
        data.side in ['A', 'B'] &&

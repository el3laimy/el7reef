rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return isAuthenticated() && request.auth.uid in participants;
    }

    function isMatchOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function isMatchOrganizerById(matchId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId))
          .data.organizerId == request.auth.uid;
    }

    function isTournamentOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function ownsFantasyTeam(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/fantasyTeams/$(teamId)) &&
        get(/databases/$(database)/documents/fantasyTeams/$(teamId))
          .data.ownerPlayerId == request.auth.uid;
    }

    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(playerId);
      allow update: if isOwner(playerId);
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.organizerId == request.auth.uid;
      allow update: if isMatchOrganizer();
      allow delete: if false;

      match /player_stats/{playerId} {
        allow read: if isAuthenticated();
        allow create, update: if isMatchOrganizerById(matchId);
        allow delete: if false;
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.organizerId == request.auth.uid;
      allow update: if isTournamentOrganizer();
      allow delete: if false;
    }

    match /ratingEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /encounterLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /organizerActions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isAuthenticated();
      allow create: if isParticipant(request.resource.data.participants);
      allow update, delete: if isParticipant(resource.data.participants);
    }

    match /reservedUsernames/{username} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.previousOwnerId == request.auth.uid
      );
      allow delete: if false;
    }

    match /fanVotingSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isMatchOrganizerById(sessionId);
      allow delete: if false;
    }

    match /userVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /fantasyLeagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /fantasyTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerPlayerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerPlayerId == request.auth.uid &&
        request.resource.data.ownerPlayerId == resource.data.ownerPlayerId;
      allow delete: if false;
    }

    match /fantasySlots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        ownsFantasyTeam(request.resource.data.fantasyTeamId);
      allow delete: if false;
    }

    match /transferRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        ownsFantasyTeam(request.resource.data.fantasyTeamId);
      allow update, delete: if false;
    }

    match /playerFantasyValues/{valueId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}

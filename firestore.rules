        data.keys().hasOnly([
          'username',
          'ownerId',
          'previousOwnerId',
          'status',
          'claimedAt',
          'reservedAt',
          'expiresAt'
        ]) &&
        data.username is string &&
        data.username == docId &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid;
    }

    function canClaimExpiredReservedUsername() {
      return resource.data.status == 'reserved' &&
        resource.data.expiresAt is int &&
        resource.data.expiresAt <= request.time.toMillis();
    }

    function canUpdateReservedUsername() {
      return isAuthenticated() &&
        (
          resource.data.ownerId == request.auth.uid ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
              'ownerId',
              'status',
              'claimedAt',
              'expiresAt'
            ]) &&
            request.resource.data.ownerId is string &&
            request.resource.data.ownerId == request.auth.uid &&
            request.resource.data.status == 'active' &&
            request.resource.data.claimedAt is int &&
            request.resource.data.expiresAt == null &&
            canClaimExpiredReservedUsername()
          )
        );
    }

    function matchOperationRefsUnchanged() {
      return request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.sideKey == resource.data.sideKey &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function validTournamentParticipant(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'sourceType',
          'sourceEntityId',
          'displayName',
          'status',
          'seed',
          'groupId',
          'sourceRegistrationId',
          'replacementForParticipantId',
          'replacedByParticipantId',
          'createdAt',
          'updatedAt',
          'approvedAt',
          'finalizedAt',
          'withdrawnAt',
          'replacedAt'
        ]) &&
        data.tournamentId is string &&
        data.sourceType in ['registeredTeam', 'guestTeam'] &&
        data.sourceEntityId is string &&
        data.displayName is string &&
        data.status in ['approved', 'finalized', 'withdrawn', 'replaced'] &&
        nullableInt(data, 'seed') &&
        nullableString(data, 'groupId') &&
        nullableString(data, 'sourceRegistrationId') &&
        nullableString(data, 'replacementForParticipantId') &&
        nullableString(data, 'replacedByParticipantId') &&
        data.createdAt is int &&
        data.updatedAt is int &&
        nullableInt(data, 'approvedAt') &&
        nullableInt(data, 'finalizedAt') &&
        nullableInt(data, 'withdrawnAt') &&
        nullableInt(data, 'replacedAt');
    }

    function participantSourceRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.sourceType == resource.data.sourceType &&
        request.resource.data.sourceEntityId == resource.data.sourceEntityId;
    }

    function validTournamentGroup(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'groupStageId',
          'name',
          'order',
          'participantIds',
          'qualifierParticipantIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.tournamentId is string &&
        data.groupStageId is string &&
        data.name is string &&
        data.order is int &&
        data.participantIds is list &&
        data.qualifierParticipantIds is list &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function groupRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.groupStageId == resource.data.groupStageId;
    }

    function validGroupStandingSnapshot(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'groupStageId',
          'groupId',
          'tiebreakerOrder',
          'entries',
          'qualifierParticipantIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.tournamentId is string &&
        data.groupStageId is string &&
        data.groupId is string &&
        data.tiebreakerOrder is list &&
        data.entries is list &&
        data.qualifierParticipantIds is list &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function standingRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.groupStageId == resource.data.groupStageId &&
        request.resource.data.groupId == resource.data.groupId;
    }

    function validKnockoutBracket(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.tournamentId is string &&
        data.format == 'singleElimination' &&
        data.qualifierParticipantIds is list &&
        nullableString(data, 'championParticipantId') &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function validKnockoutTie(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'bracketId',
          'roundIndex',
          'slotNumber',
          'participantAId',
          'participantBId',
          'winnerParticipantId',
          'matchId',
          'nextTieId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.tournamentId is string &&
        data.bracketId is string &&
        data.roundIndex is int &&
        data.slotNumber is int &&
        nullableString(data, 'participantAId') &&
        nullableString(data, 'participantBId') &&
        nullableString(data, 'winnerParticipantId') &&
        nullableString(data, 'matchId') &&
        nullableString(data, 'nextTieId') &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function tieRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.bracketId == resource.data.bracketId;
    }

    function validMatchSide(data) {
      return data.keys().hasOnly([
          'matchId',
          'sideKey',
          'type',
          'displayName',
          'officialTeamId',
          'captainUserId',
          'managedByUserIds',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.matchId is string &&
        data.sideKey in ['A', 'B'] &&
        data.type in ['temporary', 'officialTeam'] &&
        data.displayName is string &&
        nullableString(data, 'officialTeamId') &&
        nullableString(data, 'captainUserId') &&
        data.managedByUserIds is list &&
        data.createdBy is string &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function validMatchSidePlayer(data) {
      return data.keys().hasOnly([
          'matchId',
          'sideKey',
          'sideId',
          'kind',
          'playerId',
          'displayName',
          'position',
          'shirtNumber',
          'ratingEligible',
          'addedBy',
          'createdAt'
        ]) &&
        data.matchId is string &&
        data.sideKey in ['A', 'B'] &&
        data.sideId is string &&
        data.kind in ['temporary', 'registered'] &&
        nullableString(data, 'playerId') &&
        data.displayName is string &&
        nullableString(data, 'position') &&
        nullableInt(data, 'shirtNumber') &&
        data.ratingEligible is bool &&
        data.addedBy is string &&
        data.createdAt is int;
    }

    function matchSidePlayerRefsUnchanged() {
      return matchOperationRefsUnchanged() &&
        request.resource.data.sideId == resource.data.sideId &&
        request.resource.data.kind == resource.data.kind &&
        request.resource.data.addedBy == resource.data.addedBy;
    }

    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(playerId);
      allow update: if isOwner(playerId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'rating',
            'totalMatches',
            'wins',
            'draws',
            'losses',
            'mvpCount',
            'trustWeight',
            'trustLevel',
            'role',
            'isGuest',
            'createdAt'
          ]);
      allow delete: if false;
    }

    match /guestPlayers/{guestPlayerId} {
      allow read: if canManageGuestPlayer(resource.data);
      allow create: if canCreateGuestPlayer(request.resource.data);
      allow update: if (
        canManageGuestPlayer(resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy
      ) || canSelfClaimGuestPlayer(guestPlayerId);
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    match /teamMemberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId);
      allow update: if (
        isAuthenticated() &&
        canManageTeamById(resource.data.teamId) &&
        request.resource.data.teamId == resource.data.teamId
      ) || canSelfClaimMembership();
      allow delete: if false;
    }

    match /teamFormationTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId);
      allow update: if isAuthenticated() &&
        canManageTeamById(resource.data.teamId) &&
        request.resource.data.teamId == resource.data.teamId;
      allow delete: if isAuthenticated() &&
        canManageTeamById(resource.data.teamId);
    }

    match /teamRosterSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId);
      allow update, delete: if false;
    }

    match /guestTeams/{guestTeamId} {
      allow read: if canReadGuestTeam(resource.data);
      allow create: if canManageGuestTeam(request.resource.data);
      allow update: if (
        canManageGuestTeam(resource.data) &&
        request.resource.data.creatorId == resource.data.creatorId
      ) || canSelfClaimGuestTeam(guestTeamId) ||
        canUpdateGuestTeamRosterCaptain(guestTeamId);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if canCreateMatch(request.resource.data, matchId);
      allow update: if isMatchOrganizer() ||
        isAssistantLineupSnapshotIdUpdate(matchId) ||
        isAssistantScoreApprovalUpdate(matchId) ||
        isAssistantScoreSubmissionUpdate(matchId) ||
        isAssistantPrideEventsPendingClear(matchId);
      allow delete: if false;

      match /player_stats/{playerId} {
        allow read: if isAuthenticated();
        allow create, update: if isMatchOrganizerById(matchId) ||
          hasActiveAssistantPermissionForMatch(matchId, 'canSubmitScore');
        allow delete: if false;
      }

      match /pendingPrideEvents/{payloadId} {
        allow read: if isAuthenticated();
        allow create, update: if payloadId == 'current' &&
          canSubmitAndRecordForMatch(matchId) &&
          isValidPendingPridePayload(request.resource.data, matchId);
        allow delete: if payloadId == 'current' &&
          canSubmitAndRecordForMatch(matchId);
      }
    }

    match /matchEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if canCreateMatchEvent(request.resource.data);
      allow update: if canVoidMatchEvent();
      allow delete: if false;
    }

    match /matchCheckIns/{checkInId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update: if (
        canManageMatchdaySide(resource.data) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.guestTeamId == resource.data.guestTeamId
      );
      allow delete: if false;
    }

    match /matchAttendances/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update: if (
        canManageMatchdaySide(resource.data) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.guestTeamId == resource.data.guestTeamId
      );
      allow delete: if false;
    }

    match /matchLineupSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update: if false;
      allow delete: if canUnlockLineupSnapshot(resource.data);
    }

    match /matchSubstitutions/{substitutionId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update, delete: if false;
    }

    match /{path=**}/followers/{followerUserId} {
      allow get: if canReadOwnFollowerDocument(followerUserId);
      allow list: if isAuthenticated() &&
        resource.data.userId is string &&
        resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /tournaments/{tournamentId} {
      allow get: if isAuthenticated() &&
        (
          isPublicTournament(resource.data) ||
          canReadPrivateTournament(resource.data, tournamentId)
        );
      allow list: if canListTournament(resource.data);
      allow create: if isAuthenticated() &&
        request.resource.data.organizerId == request.auth.uid;
      allow update: if isTournamentOrganizer();
      allow delete: if false;

      match /assistants/{assistantUserId} {
        allow get: if canGetAssistantPermission(tournamentId, assistantUserId);
        allow list: if organizesTournamentById(tournamentId);
        allow create: if canCreateAssistantPermission(
          tournamentId,
          assistantUserId
        );
        allow update: if canUpdateAssistantPermission(
          tournamentId,
          assistantUserId
        );
        allow delete: if false;
      }

      match /followers/{followerUserId} {
        allow get: if isOwner(followerUserId) ||
          organizesTournamentById(tournamentId);
        allow list: if isAuthenticated() &&
          (
            organizesTournamentById(tournamentId) ||
            resource.data.userId == request.auth.uid
          );
        allow create: if isOwner(followerUserId) &&
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId))
            .data.organizerId != request.auth.uid &&
          validTournamentFollower(
            request.resource.data,
            tournamentId,
            followerUserId
          );
        allow update: if false;
        allow delete: if isOwner(followerUserId);
      }
    }

    match /tournamentRegistrations/{registrationId} {
      allow read: if canReadTournamentRegistration(resource.data);
      allow create: if canCreateTournamentRegistration(request.resource.data);
      allow update: if canUpdateTournamentRegistration();
      allow delete: if false;
    }

    match /tournamentParticipants/{participantId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validTournamentParticipant(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        participantSourceRefsUnchanged() &&
        validTournamentParticipant(request.resource.data);
      allow delete: if ownsExistingTournamentOperation();
    }

    match /tournamentGroups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validTournamentGroup(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        groupRefsUnchanged() &&
        validTournamentGroup(request.resource.data);
      allow delete: if ownsExistingTournamentOperation();
    }

    match /groupStandingSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validGroupStandingSnapshot(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        standingRefsUnchanged() &&
        validGroupStandingSnapshot(request.resource.data);
      allow delete: if ownsExistingTournamentOperation();
    }

    match /knockoutBrackets/{bracketId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validKnockoutBracket(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        tournamentOperationRefsUnchanged() &&
        validKnockoutBracket(request.resource.data);
      allow delete: if false;
    }

    match /knockoutTies/{tieId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validKnockoutTie(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        tieRefsUnchanged() &&
        validKnockoutTie(request.resource.data);
      allow delete: if false;
    }

    match /matchSides/{sideId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchOperationById(
          request.resource.data.matchId
        ) &&
        validMatchSide(request.resource.data);
      allow update: if canManageMatchOperationById(resource.data.matchId) &&
        matchOperationRefsUnchanged() &&
        validMatchSide(request.resource.data);
      allow delete: if false;
    }

    match /matchSidePlayers/{playerId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchOperationById(
          request.resource.data.matchId
        ) &&
        validMatchSidePlayer(request.resource.data);
      allow update: if canManageMatchOperationById(resource.data.matchId) &&
        matchSidePlayerRefsUnchanged() &&
        validMatchSidePlayer(request.resource.data);
      allow delete: if canManageMatchOperationById(resource.data.matchId);
    }

    match /ratingEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /encounterLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /organizerActions/{actionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /challenges/{challengeId} {
      allow read: if isChallengeParticipant(resource.data);
      allow create: if canCreateChallenge(request.resource.data);
      allow update: if canUpdateChallenge(challengeId);
      allow delete: if false;
    }

    match /matchInvitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create: if canCreateMatchInvitation(request.resource.data);
      allow update: if canUpdateMatchInvitation();
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isAuthenticated();
      allow create: if isParticipant(request.resource.data.participants);
      allow update, delete: if isParticipant(resource.data.participants);
    }

    match /reservedUsernames/{username} {
      allow read: if isAuthenticated();
      allow create: if canCreateReservedUsername(request.resource.data, username);
      allow update: if canUpdateReservedUsername();
      allow delete: if false;
    }

    match /claimCodes/{claimCodeId} {
      // V1 claim links treat the exact claim code document id as
      // proof-of-possession for client claim entry. Listing/querying all claim
      // codes would expose active invite tokens, so list access is limited to
      // creator-scoped reuse queries.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid;
      allow create: if canCreateClaimCode(request.resource.data);
      allow update: if canUpdateClaimCode(resource.data) ||
        canFinalizeGuestPlayerClaimCode() ||
        canRequestGuestTeamClaimCode() ||
        canFinalizeGuestTeamClaimCode();
      allow delete: if false;
    }

    match /fanVotingSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isMatchOrganizerById(sessionId) ||
        hasActiveAssistantPermissionForMatch(sessionId, 'canSubmitScore') ||
        hasActiveAssistantPermissionForMatch(sessionId, 'canApproveScore');
      allow delete: if false;
    }

    match /userVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /fantasyLeagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /fantasyRoundSettlements/{markerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /fantasyTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerPlayerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerPlayerId == request.auth.uid &&
        request.resource.data.ownerPlayerId == resource.data.ownerPlayerId;
      allow delete: if false;
    }

    match /fantasySlots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        ownsFantasyTeam(request.resource.data.fantasyTeamId);
      allow delete: if false;
    }

    match /transferRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        ownsFantasyTeam(request.resource.data.fantasyTeamId);
      allow update, delete: if false;
    }

    match /playerFantasyValues/{valueId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Phase 7: Audit & Disputes ──

    match /auditEvents/{eventId} {
      allow read: if canReadAuditEvent(resource.data);
      allow create, update, delete: if false;
    }

    match /analyticsEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'eventName',
          'actorId',
          'parameters',
          'createdAt'
        ]) &&
        request.resource.data.eventName is string &&
        request.resource.data.createdAt is int &&
        (
          !request.resource.data.keys().hasAny(['parameters']) ||
          request.resource.data.parameters is map
        ) &&
        (
          !request.resource.data.keys().hasAny(['actorId']) ||
          (
            request.resource.data.actorId is string &&
            isAuthenticated() &&
            request.resource.data.actorId == request.auth.uid
          )
        );
      allow update, delete: if false;
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated();
      // Players can create disputes on their own matches
      allow create: if isAuthenticated() &&
        request.resource.data.raisedBy == request.auth.uid &&
        request.resource.data.matchId is string;
      // Only the tournament organizer can resolve/reject
      allow update: if isAuthenticated() &&
        resource.data.matchId is string &&
        isMatchOrganizerById(resource.data.matchId) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.raisedBy == resource.data.raisedBy &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // ── Catch-all: block any unknown collection ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

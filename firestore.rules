    function validTournamentParticipant(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'sourceType',
          'sourceEntityId',
          'displayName',
          'status',
          'seed',
          'groupId',
          'sourceRegistrationId',
          'replacementForParticipantId',
          'replacedByParticipantId',
          'createdAt',
          'updatedAt',
          'approvedAt',
          'finalizedAt',
          'withdrawnAt',
          'replacedAt'
        ]) &&
        data.tournamentId is string &&
        data.sourceType in ['registeredTeam', 'guestTeam'] &&
        data.sourceEntityId is string &&
        data.displayName is string &&
        data.status in ['approved', 'finalized', 'withdrawn', 'replaced'] &&
        nullableInt(data, 'seed') &&
        nullableString(data, 'groupId') &&
        nullableString(data, 'sourceRegistrationId') &&
        nullableString(data, 'replacementForParticipantId') &&
        nullableString(data, 'replacedByParticipantId') &&
        data.createdAt is int &&
        data.updatedAt is int &&
        nullableInt(data, 'approvedAt') &&
        nullableInt(data, 'finalizedAt') &&
        nullableInt(data, 'withdrawnAt') &&

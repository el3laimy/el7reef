rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return isAuthenticated() && request.auth.uid in participants;
    }

    function isMatchOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function isMatchOrganizerById(matchId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId))
          .data.organizerId == request.auth.uid;
    }

    function isTournamentOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function hasActiveTournamentAssistant(tournamentId) {
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.status == 'active';
    }

    function canReadPrivateTournament(data, tournamentId) {
      return isAuthenticated() &&
        (
          data.organizerId == request.auth.uid ||
          hasActiveTournamentAssistant(tournamentId) ||
          (
            data.participantViewerIds is list &&
            request.auth.uid in data.participantViewerIds
          )
        );
    }

    function isPublicTournament(data) {
      return !data.keys().hasAny(['visibility']) ||
        data.visibility == 'public';
    }

    function canListTournament(data) {
      return isAuthenticated() &&
        isPublicTournament(data) &&
        (
          !data.keys().hasAny(['discoverable']) ||
          data.discoverable == true
        );
    }

    function ownsTeamById(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId))
          .data.ownerId == request.auth.uid;
    }

    function canManageTeamById(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        (
          get(/databases/$(database)/documents/teams/$(teamId))
            .data.ownerId == request.auth.uid ||
          request.auth.uid in
            get(/databases/$(database)/documents/teams/$(teamId))
              .data.viceCaptainIds
        );
    }

    function organizesTournamentById(tournamentId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId))
          .data.organizerId == request.auth.uid;
    }

    function canManageGuestPlayer(data) {
      return isAuthenticated() && (
        (data.createdBy is string && data.createdBy == request.auth.uid) ||
        (data.teamId is string && canManageTeamById(data.teamId)) ||
        (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId)) ||
        (data.tournamentId is string && organizesTournamentById(data.tournamentId)) ||
        (
          data.guestTeamId is string &&
          data.tournamentId is string &&
          hasGuestRosterAssistantPermissionForGuestTeam(
            data.guestTeamId,
            data.tournamentId
          )
        )
      );
    }

    function canCreateGuestPlayer(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        (
          (data.teamId is string && canManageTeamById(data.teamId)) ||
          (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId)) ||
          (data.tournamentId is string && organizesTournamentById(data.tournamentId)) ||
          (
            data.guestTeamId is string &&
            data.tournamentId is string &&
            hasGuestRosterAssistantPermissionForGuestTeam(
              data.guestTeamId,
              data.tournamentId
            )
          )
        );
    }

    function canManageGuestTeam(data) {
      return isAuthenticated() &&
        data.creatorId is string &&
        data.creatorId == request.auth.uid;
    }

    function canUpdateGuestTeamRosterCaptain(guestTeamId) {
      return isAuthenticated() &&
        resource.data.tournamentIds is list &&
        (
          canReadGuestTeamByTournamentIds(resource.data.tournamentIds) ||
          canManageGuestRosterByTournamentIds(resource.data.tournamentIds)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['captainGuestPlayerId', 'updatedAt']) &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.tournamentIds == resource.data.tournamentIds &&
        request.resource.data.updatedAt is int &&
        (
          request.resource.data.captainGuestPlayerId == null ||
          (
            request.resource.data.captainGuestPlayerId is string &&
            exists(
              /databases/$(database)/documents/guestPlayers/$(request.resource.data.captainGuestPlayerId)
            ) &&
            get(
              /databases/$(database)/documents/guestPlayers/$(request.resource.data.captainGuestPlayerId)
            ).data.guestTeamId == guestTeamId &&
            get(
              /databases/$(database)/documents/guestPlayers/$(request.resource.data.captainGuestPlayerId)
            ).data.claimStatus != 'archived'
          )
        );
    }

    function canReadGuestTeam(data) {
      return isAuthenticated() &&
        (
          (data.creatorId is string && data.creatorId == request.auth.uid) ||
          canReadGuestTeamByTournamentIds(data.tournamentIds) ||
          canManageGuestRosterByTournamentIds(data.tournamentIds)
        );
    }

    function canReadGuestTeamByTournamentIds(tournamentIds) {
      return tournamentIds is list &&
        (
          (
            tournamentIds.size() > 0 &&
            tournamentIds[0] is string &&
            organizesTournamentById(tournamentIds[0])
          ) ||
          (
            tournamentIds.size() > 1 &&
            tournamentIds[1] is string &&
            organizesTournamentById(tournamentIds[1])
          ) ||
          (
            tournamentIds.size() > 2 &&
            tournamentIds[2] is string &&
            organizesTournamentById(tournamentIds[2])
          ) ||
          (
            tournamentIds.size() > 3 &&
            tournamentIds[3] is string &&
            organizesTournamentById(tournamentIds[3])
          ) ||
          (
            tournamentIds.size() > 4 &&
            tournamentIds[4] is string &&
            organizesTournamentById(tournamentIds[4])
          )
        );
    }

    function canManageGuestRosterByTournamentIds(tournamentIds) {
      return tournamentIds is list &&
        (
          (
            tournamentIds.size() > 0 &&
            tournamentIds[0] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[0],
              'canManageGuestRoster'
            )
          ) ||
          (
            tournamentIds.size() > 1 &&
            tournamentIds[1] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[1],
              'canManageGuestRoster'
            )
          ) ||
          (
            tournamentIds.size() > 2 &&
            tournamentIds[2] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[2],
              'canManageGuestRoster'
            )
          ) ||
          (
            tournamentIds.size() > 3 &&
            tournamentIds[3] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[3],
              'canManageGuestRoster'
            )
          ) ||
          (
            tournamentIds.size() > 4 &&
            tournamentIds[4] is string &&
            hasActiveTournamentAssistantPermission(
              tournamentIds[4],
              'canManageGuestRoster'
            )
          )
        );
    }

    function hasGuestRosterAssistantPermissionForGuestTeam(
      guestTeamId,
      tournamentId
    ) {
      return isAuthenticated() &&
        guestTeamId is string &&
        tournamentId is string &&
        exists(/databases/$(database)/documents/guestTeams/$(guestTeamId)) &&
        get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
          .data.tournamentIds is list &&
        tournamentId in
          get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
            .data.tournamentIds &&
        hasActiveTournamentAssistantPermission(
          tournamentId,
          'canManageGuestRoster'
        );
    }

    function ownsGuestTeamById(guestTeamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/guestTeams/$(guestTeamId)) &&
        get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
          .data.creatorId == request.auth.uid;
    }

    function canCreateTournamentRegistration(data) {
      return isAuthenticated() &&
        data.tournamentId is string &&
        data.createdBy == request.auth.uid &&
        (
          (
            organizesTournamentById(data.tournamentId) &&
            data.status in ['pending', 'approved', 'rejected'] &&
            (
              data.status == 'pending' ||
              hasOrganizerDecisionByCurrentUser(data)
            )
          ) ||
          (
            ownsTournamentRegistrationSource(data) &&
            data.status == 'pending' &&
            hasNoOrganizerDecisionValues(data)
          )
        );
    }

    function ownsTournamentRegistrationSource(data) {
      return isAuthenticated() && (
        (data.teamId is string && ownsTeamById(data.teamId)) ||
        (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId))
      );
    }

    function hasNoOrganizerDecisionValues(data) {
      return (
          !data.keys().hasAny(['verifiedBy']) ||
          data.verifiedBy == null
        ) &&
        (
          !data.keys().hasAny(['verifiedAt']) ||
          data.verifiedAt == null
        ) &&
        (
          !data.keys().hasAny(['reviewedBy']) ||
          data.reviewedBy == null
        ) &&
        (
          !data.keys().hasAny(['reviewedAt']) ||
          data.reviewedAt == null
        ) &&
        (
          !data.keys().hasAny(['reviewerId']) ||
          data.reviewerId == null
        ) &&
        (
          !data.keys().hasAny(['rejectionReason']) ||
          data.rejectionReason == null
        ) &&
        (
          !data.keys().hasAny(['organizerNote']) ||
          data.organizerNote == null
        );
    }

    function hasOrganizerDecisionByCurrentUser(data) {
      return data.verifiedBy == request.auth.uid &&
        data.verifiedAt is int;
    }

    function registrationImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'tournamentId',
          'teamId',
          'guestTeamId',
          'claimedFromGuestTeamId',
          'createdBy',
          'submittedBy',
          'createdAt',
          'sourceId',
          'sourceType'
        ]);
    }

    function canSubmitterUpdatePendingTournamentRegistration() {
      return ownsTournamentRegistrationSource(resource.data) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == resource.data.status &&
        registrationImmutableFieldsUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mode', 'notes', 'updatedAt']);
    }

    function canOrganizerDecideTournamentRegistration() {
      return organizesTournamentById(resource.data.tournamentId) &&
        registrationImmutableFieldsUnchanged() &&
        request.resource.data.status in ['approved', 'rejected'] &&
        hasOrganizerDecisionByCurrentUser(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'verifiedBy',
            'verifiedAt',
            'reviewedBy',
            'reviewedAt',
            'reviewerId',
            'rejectionReason',
            'organizerNote',
            'notes',
            'updatedAt'
          ]);
    }

    function canUpdateTournamentRegistration() {
      return isAuthenticated() &&
        resource.data.tournamentId is string &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        (
          canOrganizerDecideTournamentRegistration() ||
          canSubmitterUpdatePendingTournamentRegistration()
        );
    }

    function canReadTournamentRegistration(data) {
      return isAuthenticated() &&
        data.tournamentId is string &&
        (
          data.status == 'approved' ||
          organizesTournamentById(data.tournamentId) ||
          ownsTournamentRegistrationSource(data) ||
          data.createdBy == request.auth.uid
        );
    }

    function canManageMatchdaySide(data) {
      return isAuthenticated() &&
        data.matchId is string &&
        (
          hasActiveAssistantPermissionForMatch(data.matchId, 'canStartMatch') ||
          (
            data.teamId is string &&
            (
              canManageTeamById(data.teamId) ||
              isMatchOrganizerById(data.matchId)
            )
          ) ||
          (
            data.guestTeamId is string &&
            (
              ownsGuestTeamById(data.guestTeamId) ||
              isMatchOrganizerById(data.matchId)
            )
          )
        );
    }

    function canUnlockLineupSnapshot(data) {
      return isAuthenticated() &&
        data.matchId is string &&
        exists(/databases/$(database)/documents/matches/$(data.matchId)) &&
        get(/databases/$(database)/documents/matches/$(data.matchId))
          .data.status in ['open', 'full'] &&
        get(/databases/$(database)/documents/matches/$(data.matchId))
          .data.isFrozen != true &&
        (
          isMatchOrganizerById(data.matchId) ||
          hasActiveAssistantPermissionForMatch(data.matchId, 'canStartMatch')
        );
    }

    function canCreateClaimCode(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        (
          (
            data.targetType == 'guestPlayer' &&
            data.targetId is string &&
            exists(/databases/$(database)/documents/guestPlayers/$(data.targetId)) &&
            canManageGuestPlayer(
              get(/databases/$(database)/documents/guestPlayers/$(data.targetId)).data
            )
          ) ||
          (
            data.targetType == 'guestTeam' &&
            data.targetId is string &&
            exists(/databases/$(database)/documents/guestTeams/$(data.targetId)) &&
            canManageGuestTeam(
              get(/databases/$(database)/documents/guestTeams/$(data.targetId)).data
            )
          ) ||
          (
            data.targetType == 'teamInvite' &&
            data.teamId is string &&
            data.targetId == data.teamId &&
            canManageTeamById(data.teamId)
          )
        );
    }

    function isActiveGuestPlayerClaimCode(claimCode, guestPlayerId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestPlayer' &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestPlayerId &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'active' &&
        (
          !(get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt is int) ||
          get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt > request.time.toMillis()
        );
    }

    function isActiveGuestTeamClaimCode(claimCode, guestTeamId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestTeam' &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestTeamId &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'active' &&
        (
          !(get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt is int) ||
          get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt > request.time.toMillis()
        );
    }

    function hasSameBatchGuestPlayerClaimProof(claimCode, guestPlayerId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestPlayer' &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestPlayerId &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'claimed' &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.claimedByPlayerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.claimedAt is int &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.updatedAt is int;
    }

    function hasSameBatchGuestTeamClaimProof(claimCode, guestTeamId, teamId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestTeam' &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestTeamId &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'claimed' &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.claimedByPlayerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.teamId == teamId &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.claimedAt is int &&
        getAfter(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.updatedAt is int;
    }

    function canSelfClaimGuestPlayer(guestPlayerId) {
      return isAuthenticated() &&
        resource.data.claimCode is string &&
        isActiveGuestPlayerClaimCode(resource.data.claimCode, guestPlayerId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'claimStatus',
            'linkedPlayerId',
            'updatedAt'
          ]) &&
        request.resource.data.updatedAt is int &&
        request.resource.data.displayName == resource.data.displayName &&
        request.resource.data.normalizedName == resource.data.normalizedName &&
        request.resource.data.phoneNumber == resource.data.phoneNumber &&
        request.resource.data.jerseyNumber == resource.data.jerseyNumber &&
        request.resource.data.preferredPosition == resource.data.preferredPosition &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.claimCode == resource.data.claimCode &&
        request.resource.data.notes == resource.data.notes &&
        request.resource.data.claimStatus == 'claimed' &&
        request.resource.data.linkedPlayerId == request.auth.uid &&
        hasSameBatchGuestPlayerClaimProof(
          resource.data.claimCode,
          guestPlayerId
        );
    }

    function canSelfClaimGuestTeam(guestTeamId) {
      return isAuthenticated() &&
        resource.data.claimCode is string &&
        isActiveGuestTeamClaimCode(resource.data.claimCode, guestTeamId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'claimStatus',
            'linkedTeamId',
            'updatedAt'
          ]) &&
        request.resource.data.updatedAt is int &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.normalizedName == resource.data.normalizedName &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.contactName == resource.data.contactName &&
        request.resource.data.contactPhone == resource.data.contactPhone &&
        request.resource.data.logoUrl == resource.data.logoUrl &&
        request.resource.data.tournamentIds == resource.data.tournamentIds &&
        request.resource.data.captainGuestPlayerId == resource.data.captainGuestPlayerId &&
        request.resource.data.claimCode == resource.data.claimCode &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.claimStatus == 'claimed' &&
        request.resource.data.linkedTeamId is string &&
        ownsTeamById(request.resource.data.linkedTeamId) &&
        hasSameBatchGuestTeamClaimProof(
          resource.data.claimCode,
          guestTeamId,
          request.resource.data.linkedTeamId
        );
    }

    function canFinalizeGuestPlayerClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestPlayer' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'claimedByPlayerId',
            'claimedAt',
            'updatedAt'
          ]) &&
        request.resource.data.claimedAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedByPlayerId == request.auth.uid;
    }

    function canRequestGuestTeamClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestTeam' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.status == 'active' &&
        request.resource.data.claimedAt == resource.data.claimedAt &&
        request.resource.data.claimedByPlayerId == request.auth.uid &&
        request.resource.data.teamId is string &&
        ownsTeamById(request.resource.data.teamId) &&
        (
          !(resource.data.teamId is string) ||
          resource.data.teamId == request.resource.data.teamId
        ) &&
        (
          !(resource.data.claimedByPlayerId is string) ||
          resource.data.claimedByPlayerId == request.auth.uid
        );
    }

    function canFinalizeGuestTeamClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestTeam' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'teamId',
            'status',
            'claimedByPlayerId',
            'claimedAt',
            'updatedAt'
          ]) &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.teamId is string &&
        (
          (
            ownsTeamById(request.resource.data.teamId) &&
            request.resource.data.claimedByPlayerId == request.auth.uid
          ) ||
          (
            resource.data.createdBy == request.auth.uid &&
            resource.data.teamId is string &&
            resource.data.teamId == request.resource.data.teamId &&
            resource.data.claimedByPlayerId is string &&
            request.resource.data.claimedByPlayerId == resource.data.claimedByPlayerId
          )
        );
    }

    function canSelfClaimMembership() {
      return isAuthenticated() &&
        resource.data.guestPlayerId is string &&
        isActiveGuestPlayerClaimCode(
          get(/databases/$(database)/documents/guestPlayers/$(resource.data.guestPlayerId))
            .data.claimCode,
          resource.data.guestPlayerId
        ) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.playerId == request.auth.uid &&
        request.resource.data.guestPlayerId == null &&
        request.resource.data.claimedFromGuestPlayerId == resource.data.guestPlayerId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.availability == resource.data.availability &&
        request.resource.data.joinedAt == resource.data.joinedAt &&
        request.resource.data.invitedBy == resource.data.invitedBy;
    }

    function canUpdateClaimCode(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&

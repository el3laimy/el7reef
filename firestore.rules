    function validGroupStandingSnapshot(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'groupStageId',
          'groupId',
          'tiebreakerOrder',
          'entries',
          'qualifierParticipantIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.tournamentId is string &&
        data.groupStageId is string &&
        data.groupId is string &&
        data.tiebreakerOrder is list &&
        data.entries is list &&
        data.qualifierParticipantIds is list &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function standingRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.groupStageId == resource.data.groupStageId &&
        request.resource.data.groupId == resource.data.groupId;
    }

    function validKnockoutBracket(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'seedingMethod',
          'byeParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'seedingMethod',
          'byeParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        isBoundedDocumentId(data.tournamentId) &&
        data.format == 'singleElimination' &&
        isBoundedDocumentIdList(data.qualifierParticipantIds, 2, 16) &&
        data.qualifierParticipantIds.toSet().size() ==
          data.qualifierParticipantIds.size() &&
        data.seedingMethod in ['ranked', 'draw', 'groupCrossPairing'] &&
        isBoundedDocumentIdList(data.byeParticipantIds, 0, 15) &&
        data.byeParticipantIds.toSet().size() ==
          data.byeParticipantIds.size() &&
        data.byeParticipantIds.toSet()
          .difference(data.qualifierParticipantIds.toSet()).size() == 0 &&
        (
          data.championParticipantId == null ||
          (
            isBoundedDocumentId(data.championParticipantId) &&
            data.championParticipantId in data.qualifierParticipantIds
          )
        ) &&
        data.createdAt is int && data.createdAt >= 0 &&
        data.updatedAt is int && data.updatedAt >= data.createdAt;
    }

    function validKnockoutBracketCreate(data) {
      return validKnockoutBracket(data) &&
        data.championParticipantId == null;
    }

    function validKnockoutBracketClientUpdate() {
      // The participant lists were deeply validated on create and are
      // immutable here. Re-validating them on every update can exceed the
      // Firestore Rules expression budget, so validate the only mutable field
      // and lock the complete persisted structure instead.
      return request.resource.data.keys().hasOnly([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'seedingMethod',
          'byeParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'seedingMethod',
          'byeParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        tournamentOperationRefsUnchanged() &&
        request.resource.data.format == resource.data.format &&
        request.resource.data.qualifierParticipantIds ==
          resource.data.qualifierParticipantIds &&
        request.resource.data.seedingMethod == resource.data.seedingMethod &&
        request.resource.data.byeParticipantIds ==
          resource.data.byeParticipantIds &&
        request.resource.data.championParticipantId ==
          resource.data.championParticipantId &&
        request.resource.data.updatedAt is int &&
        request.resource.data.updatedAt >= resource.data.updatedAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt']);
    }

    function validKnockoutTie(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'bracketId',
          'roundIndex',
          'slotNumber',
          'participantAId',
          'participantBId',
          'winnerParticipantId',
          'matchId',
          'nextTieId',
          'resolutionType',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'bracketId',
          'roundIndex',
          'slotNumber',
          'participantAId',
          'participantBId',
          'winnerParticipantId',
          'matchId',
          'nextTieId',
          'resolutionType',
          'createdAt',
          'updatedAt'
        ]) &&
        isBoundedDocumentId(data.tournamentId) &&
        isBoundedDocumentId(data.bracketId) &&
        data.roundIndex is int &&
        data.roundIndex >= 0 && data.roundIndex <= 15 &&
        data.slotNumber is int &&
        data.slotNumber >= 0 && data.slotNumber <= 32767 &&
        (
          data.participantAId == null ||
          isBoundedDocumentId(data.participantAId)
        ) &&
        (
          data.participantBId == null ||
          isBoundedDocumentId(data.participantBId)
        ) &&
        (
          data.winnerParticipantId == null ||
          isBoundedDocumentId(data.winnerParticipantId)
        ) &&
        (data.matchId == null || isBoundedDocumentId(data.matchId)) &&
        (data.nextTieId == null || isBoundedDocumentId(data.nextTieId)) &&
        data.resolutionType in [
          'pending',
          'regularTime',
          'penalties',
          'bye'
        ] &&
        data.createdAt is int && data.createdAt >= 0 &&
        data.updatedAt is int && data.updatedAt >= data.createdAt &&
        validKnockoutTieResolutionState(data);
    }

    function validKnockoutTieResolutionState(data) {
      return (
          data.resolutionType == 'pending' &&
          data.winnerParticipantId == null &&
          isBoundedDocumentId(data.matchId)
        ) ||
        (
          data.resolutionType == 'bye' &&
          data.roundIndex == 0 &&
          data.matchId == null &&
          (
            (
              isBoundedDocumentId(data.participantAId) &&
              data.participantBId == null &&
              data.winnerParticipantId == data.participantAId
            ) ||
            (
              data.participantAId == null &&
              isBoundedDocumentId(data.participantBId) &&
              data.winnerParticipantId == data.participantBId
            )
          )
        ) ||
        (
          data.resolutionType in ['regularTime', 'penalties'] &&
          isBoundedDocumentId(data.participantAId) &&
          isBoundedDocumentId(data.participantBId) &&
          isBoundedDocumentId(data.matchId) &&
          data.winnerParticipantId in [
            data.participantAId,
            data.participantBId
          ]
        );
    }

    function validKnockoutTieCreate(data) {
      return validKnockoutTie(data) &&
        data.resolutionType in ['pending', 'bye'];
    }

    function validKnockoutTieClientUpdate() {
      return validKnockoutTie(request.resource.data) &&

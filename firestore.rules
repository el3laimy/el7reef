rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SEC-107 client-writable schemas use millisecond integer timestamps.
    // Claim token bindings and linked identities are server-authoritative.
    // guestPlayers: bounded names/contact/roster references, immutable creator
    // and source references, and guest|invited|claimed|archived status.
    // guestTeams: bounded identity/contact fields, up to five tournament IDs,
    // immutable creator/createdAt, and a verified captain reference.
    // teamMemberships: one player identity, bounded roster enums and IDs,
    // immutable team/identity/joinedAt/inviter fields after creation.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return isAuthenticated() && request.auth.uid in participants;
    }

    function isMatchOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function isMatchOrganizerById(matchId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId))
          .data.organizerId == request.auth.uid;
    }

    function isTournamentOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function hasActiveTournamentAssistant(tournamentId) {
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.status == 'active';
    }

    function canReadPrivateTournament(data, tournamentId) {
      return isAuthenticated() &&
        (
          data.organizerId == request.auth.uid ||
          hasActiveTournamentAssistant(tournamentId) ||
          (
            data.participantViewerIds is list &&
            request.auth.uid in data.participantViewerIds
          )
        );
    }

    function isPublicTournament(data) {
      return !data.keys().hasAny(['visibility']) ||
        data.visibility == 'public';
    }

    function validOptionalTournamentString(value, maxLength) {
      return value == null ||
        (value is string && value.size() <= maxLength);
    }

    function validOptionalTournamentInt(value, minValue, maxValue) {
      return value == null ||
        (value is int && value >= minValue && value <= maxValue);
    }

    function validTournamentLogoUrl(value) {
      return value == null || value in [
        'preset://v1/tournament_emblem/floodlights',
        'preset://v1/tournament_emblem/center_circle',
        'preset://v1/tournament_emblem/street_gate',
        'preset://v1/tournament_emblem/whistle',
        'preset://v1/tournament_emblem/match_ball',
        'preset://v1/tournament_emblem/tournament_flame'
      ];
    }

    function validTeamPresetLogoUrl(value) {
      return value == null || value in [
        'preset://v1/team_badge/street_bolt',
        'preset://v1/team_badge/falcon_wing',
        'preset://v1/team_badge/fortress_gate',
        'preset://v1/team_badge/street_flame',
        'preset://v1/team_badge/city_bridge',
        'preset://v1/team_badge/shield_stripes',
        'preset://v1/team_badge/night_panther',
        'preset://v1/team_badge/goal_net',
        'preset://v1/team_badge/sunrise_pitch',
        'preset://v1/team_badge/crossed_lines',
        'preset://v1/team_badge/twin_floodlights',
        'preset://v1/team_badge/city_blocks',
        'preset://v1/team_pennant/diagonal_dash',
        'preset://v1/team_pennant/sharp_chevron',
        'preset://v1/team_pennant/split_lanes',
        'preset://v1/team_pennant/horizon_wave',
        'preset://v1/team_pennant/fast_sash',
        'preset://v1/team_pennant/goal_channels'
      ];
    }

    function validTeamLogoUrl(value) {
      return validTeamPresetLogoUrl(value) ||
        (
          value is string &&
          value.size() > 8 &&
          value.size() <= 2048 &&
          value.matches('^https://[^ ]+$')
        );
    }

    function validTournamentDocument(data) {
      return data.keys().hasOnly([
          'organizerId',
          'name',
          'logoUrl',
          'description',
          'location',
          'format',
          'teamSize',
          'maxTeams',
          'visibility',
          'discoverable',
          'isFeatured',
          'featuredPriority',
          'participantViewerIds',
          'prizePool',
          'prizeDescription',
          'status',
          'registeredTeamIds',
          'registeredTeamCount',
          'guestTeamCount',
          'approvedParticipantCount',
          'assistants',
          'groupRoundIds',
          'knockoutRoundIds',
          'isFantasyEnabled',
          'registrationDeadline',
          'startDate',
          'endDate',
          'participantListFinalizedAt',
          'activeParticipantCount',
          'currentGroupStageId',
          'currentKnockoutBracketId',
          'winnerParticipantId',
          'needsManualOpsMigration',
          'groupAdvancementConfig',
          'groupStandingsConfig',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'organizerId',
          'name',
          'format',
          'teamSize',
          'maxTeams',
          'status',
          'createdAt'
        ]) &&
        data.organizerId is string &&
        data.organizerId.size() > 0 &&
        data.organizerId.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        validTournamentLogoUrl(data.get('logoUrl', null)) &&
        validOptionalTournamentString(data.get('description', null), 600) &&
        validOptionalTournamentString(data.get('location', null), 160) &&
        data.format in [
          'groups',
          'knockout',
          'groupsOnly',
          'knockoutOnly',
          'groupsThenKnockout'
        ] &&
        data.teamSize is int &&
        data.teamSize >= 5 &&
        data.teamSize <= 11 &&
        data.maxTeams is int &&
        data.maxTeams >= 2 &&
        data.maxTeams <= 128 &&
        data.get('visibility', 'public') in ['public', 'private', 'inviteOnly'] &&
        data.get('discoverable', true) is bool &&
        data.get('isFeatured', false) is bool &&
        data.get('featuredPriority', 1000) is int &&
        data.get('featuredPriority', 1000) >= 0 &&
        data.get('featuredPriority', 1000) <= 1000 &&
        data.get('participantViewerIds', []) is list &&
        data.get('participantViewerIds', []).size() <= 200 &&
        validOptionalTournamentInt(data.get('prizePool', null), 0, 1000000000) &&
        validOptionalTournamentString(data.get('prizeDescription', null), 300) &&
        data.status in [
          'upcoming',
          'registration',
          'groupStage',
          'transferWindow',
          'knockoutStage',
          'active',
          'completed',
          'cancelled'
        ] &&
        data.get('registeredTeamIds', []) is list &&
        data.get('registeredTeamIds', []).size() <= 128 &&
        validOptionalTournamentInt(data.get('registeredTeamCount', null), 0, 128) &&
        validOptionalTournamentInt(data.get('guestTeamCount', null), 0, 128) &&
        validOptionalTournamentInt(data.get('approvedParticipantCount', null), 0, 128) &&
        data.get('assistants', []) is list &&
        data.get('assistants', []).size() <= 20 &&
        data.get('groupRoundIds', []) is list &&
        data.get('groupRoundIds', []).size() <= 128 &&
        data.get('knockoutRoundIds', []) is list &&
        data.get('knockoutRoundIds', []).size() <= 128 &&
        data.get('isFantasyEnabled', false) is bool &&
        validOptionalTournamentInt(data.get('registrationDeadline', null), 0, 4102444800000) &&
        validOptionalTournamentInt(data.get('startDate', null), 0, 4102444800000) &&
        validOptionalTournamentInt(data.get('endDate', null), 0, 4102444800000) &&
        validOptionalTournamentInt(data.get('participantListFinalizedAt', null), 0, 4102444800000) &&
        validOptionalTournamentInt(data.get('activeParticipantCount', null), 0, 128) &&
        validOptionalTournamentString(data.get('currentGroupStageId', null), 160) &&
        validOptionalTournamentString(data.get('currentKnockoutBracketId', null), 160) &&
        validOptionalTournamentString(data.get('winnerParticipantId', null), 160) &&
        data.get('needsManualOpsMigration', false) is bool &&
        (
          !data.keys().hasAny(['groupAdvancementConfig']) ||
          (
            data.groupAdvancementConfig is map &&
            data.groupAdvancementConfig.keys().hasOnly([
              'groupCount',
              'automaticQualifiersPerGroup',
              'bestRankedAdditionalQualifiers'
            ]) &&
            validOptionalTournamentInt(
              data.groupAdvancementConfig.get('groupCount', null),
              1,
              32
            ) &&
            data.groupAdvancementConfig.automaticQualifiersPerGroup is int &&
            data.groupAdvancementConfig.automaticQualifiersPerGroup >= 1 &&
            data.groupAdvancementConfig.automaticQualifiersPerGroup <= 16 &&
            data.groupAdvancementConfig.bestRankedAdditionalQualifiers is int &&
            data.groupAdvancementConfig.bestRankedAdditionalQualifiers >= 0 &&
            data.groupAdvancementConfig.bestRankedAdditionalQualifiers <= 64
          )
        ) &&
        (
          !data.keys().hasAny(['groupStandingsConfig']) ||
          (
            data.groupStandingsConfig is map &&
            data.groupStandingsConfig.keys().hasOnly(['tiebreakerOrder']) &&
            data.groupStandingsConfig.tiebreakerOrder is list &&
            data.groupStandingsConfig.tiebreakerOrder.size() >= 1 &&
            data.groupStandingsConfig.tiebreakerOrder.size() <= 4
          )
        ) &&
        data.createdAt is int &&
        data.createdAt >= 0 &&
        data.createdAt <= 4102444800000 &&
        validOptionalTournamentInt(data.get('updatedAt', null), 0, 4102444800000);
    }

    function createsUnfeaturedTournament(data) {
      return data.get('isFeatured', false) == false &&
        data.get('featuredPriority', 1000) == 1000;
    }

    function preservesTournamentAuthorityAndPromotion() {
      return request.resource.data.organizerId == resource.data.organizerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.get('isFeatured', false) ==
          resource.data.get('isFeatured', false) &&
        request.resource.data.get('featuredPriority', 1000) ==
          resource.data.get('featuredPriority', 1000);
    }

    function canListTournament(data) {
      return isAuthenticated() &&
        data.keys().hasAll(['visibility', 'discoverable']) &&
        data.visibility == 'public' &&
        data.discoverable == true;
    }

    function ownsTeamById(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId))
          .data.ownerId == request.auth.uid;
    }

    function canManageTeamById(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        (
          get(/databases/$(database)/documents/teams/$(teamId))
            .data.ownerId == request.auth.uid ||
          request.auth.uid in
            get(/databases/$(database)/documents/teams/$(teamId))
              .data.viceCaptainIds
        );
    }

    function organizesTournamentById(tournamentId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId))
          .data.organizerId == request.auth.uid;
    }

    function canManageGuestPlayer(data) {
      return isAuthenticated() && (
        (data.createdBy is string && data.createdBy == request.auth.uid) ||
        (data.teamId is string && canManageTeamById(data.teamId)) ||
        (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId)) ||
        (data.tournamentId is string && organizesTournamentById(data.tournamentId)) ||
        (
          data.guestTeamId is string &&
          data.tournamentId is string &&
          hasGuestRosterAssistantPermissionForGuestTeam(
            data.guestTeamId,
            data.tournamentId
          )
        )
      );
    }

    function isLinkedGuestPlayer(data) {
      return isAuthenticated() &&
        data.linkedPlayerId is string &&
        data.linkedPlayerId == request.auth.uid;
    }

    function validGuestPlayerDocumentKeys(data) {
      return data.keys().hasOnly([
          'displayName',
          'normalizedName',
          'phoneNumber',
          'jerseyNumber',
          'preferredPosition',
          'teamId',
          'guestTeamId',
          'tournamentId',
          'createdBy',
          'createdAt',
          'updatedAt',
          'claimStatus',
          'claimCode',
          'activeClaimTokenHash',
          'linkedPlayerId',
          'notes'
        ]);
    }

    function validOptionalBoundedString(value, maxLength) {
      return value == null ||
        (value is string && value.size() <= maxLength);
    }

    function validOptionalDocumentId(value) {
      return value == null || isBoundedDocumentId(value);
    }

    function validEpochMillis(value) {
      return value is int && value >= 0 && value <= 4102444800000;
    }

    function validOptionalClaimCode(value) {
      return value == null ||
        (
          value is string &&
          value.size() > 0 &&
          value.size() <= 128 &&
          value.matches('^[A-Za-z0-9_-]+$')
        );
    }

    function validOptionalClaimTokenHash(value) {
      return value == null ||
        (
          value is string &&
          value.size() == 64 &&
          value.matches('^[a-f0-9]+$')
        );
    }

    function validGuestClaimStatus(status) {
      return status in ['guest', 'invited', 'claimed', 'archived'];
    }

    function validGuestPlayerDocument(data) {
      return validGuestPlayerDocumentKeys(data) &&
        data.keys().hasAll([
          'displayName',
          'normalizedName',
          'createdBy',
          'createdAt',
          'updatedAt',
          'claimStatus'
        ]) &&
        data.displayName is string &&
        data.displayName.size() > 0 &&
        data.displayName.size() <= 120 &&
        data.normalizedName is string &&
        data.normalizedName.size() > 0 &&
        data.normalizedName.size() <= 180 &&
        validOptionalBoundedString(data.get('phoneNumber', null), 32) &&
        (
          data.get('jerseyNumber', null) == null ||
          (
            data.jerseyNumber is int &&
            data.jerseyNumber >= 0 &&
            data.jerseyNumber <= 999
          )
        ) &&
        validOptionalBoundedString(data.get('preferredPosition', null), 80) &&
        validOptionalDocumentId(data.get('teamId', null)) &&
        validOptionalDocumentId(data.get('guestTeamId', null)) &&
        validOptionalDocumentId(data.get('tournamentId', null)) &&
        isBoundedDocumentId(data.createdBy) &&
        validEpochMillis(data.createdAt) &&
        validEpochMillis(data.updatedAt) &&
        data.updatedAt >= data.createdAt &&
        validGuestClaimStatus(data.claimStatus) &&
        validOptionalClaimCode(data.get('claimCode', null)) &&
        validOptionalClaimTokenHash(data.get('activeClaimTokenHash', null)) &&
        validOptionalDocumentId(data.get('linkedPlayerId', null)) &&
        validOptionalBoundedString(data.get('notes', null), 500);
    }

    function canCreateGuestPlayer(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        validGuestPlayerDocument(data) &&
        data.get('claimStatus', 'guest') == 'guest' &&
        data.get('claimCode', null) == null &&
        data.get('activeClaimTokenHash', null) == null &&
        data.get('linkedPlayerId', null) == null &&
        (
          (data.teamId is string && canManageTeamById(data.teamId)) ||
          (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId)) ||
          (data.tournamentId is string && organizesTournamentById(data.tournamentId)) ||
          (
            data.guestTeamId is string &&
            data.tournamentId is string &&
            hasGuestRosterAssistantPermissionForGuestTeam(
              data.guestTeamId,
              data.tournamentId
            )
          )
        );
    }

    function guestPlayerAuthorityFieldsUnchanged() {
      return request.resource.data.get('claimCode', null) ==
          resource.data.get('claimCode', null) &&
        request.resource.data.get('activeClaimTokenHash', null) ==
          resource.data.get('activeClaimTokenHash', null) &&
        request.resource.data.get('linkedPlayerId', null) ==
          resource.data.get('linkedPlayerId', null);
    }

    function guestPlayerSourceFieldsUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.get('teamId', null) ==
          resource.data.get('teamId', null) &&
        request.resource.data.get('guestTeamId', null) ==
          resource.data.get('guestTeamId', null) &&
        request.resource.data.get('tournamentId', null) ==
          resource.data.get('tournamentId', null);
    }

    function validGuestPlayerStatusTransition() {
      return request.resource.data.claimStatus == resource.data.claimStatus ||
        (
          request.resource.data.claimStatus == 'archived' &&
          resource.data.claimStatus == 'guest' &&
          resource.data.get('claimCode', null) == null &&
          resource.data.get('activeClaimTokenHash', null) == null &&
          resource.data.get('linkedPlayerId', null) == null
        );
    }

    function canManageGuestTeam(data) {
      return isAuthenticated() &&
        data.creatorId is string &&
        data.creatorId == request.auth.uid;
    }

    function validGuestTeamDocumentKeys(data) {
      return data.keys().hasOnly([
          'name',
          'normalizedName',
          'creatorId',
          'contactName',
          'contactPhone',
          'logoUrl',
          'tournamentIds',
          'captainGuestPlayerId',
          'claimStatus',
          'claimCode',
          'activeClaimTokenHash',
          'linkedTeamId',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validInitialGuestTeam(data) {
      return validGuestTeamDocument(data) &&
        data.get('claimStatus', 'guest') == 'guest' &&
        data.get('claimCode', null) == null &&
        data.get('activeClaimTokenHash', null) == null &&
        data.get('linkedTeamId', null) == null &&
        data.get('captainGuestPlayerId', null) == null;
    }

    function validGuestTeamTournamentIds(value) {
      return value is list &&
        value.size() <= 5 &&
        (value.size() <= 0 || isBoundedDocumentId(value[0])) &&
        (value.size() <= 1 || isBoundedDocumentId(value[1])) &&
        (value.size() <= 2 || isBoundedDocumentId(value[2])) &&
        (value.size() <= 3 || isBoundedDocumentId(value[3])) &&
        (value.size() <= 4 || isBoundedDocumentId(value[4]));
    }

    function validGuestTeamDocument(data) {
      return validGuestTeamDocumentKeys(data) &&
        data.keys().hasAll([
          'name',
          'normalizedName',
          'creatorId',
          'tournamentIds',
          'claimStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.normalizedName is string &&
        data.normalizedName.size() > 0 &&
        data.normalizedName.size() <= 180 &&
        isBoundedDocumentId(data.creatorId) &&
        validOptionalBoundedString(data.get('contactName', null), 120) &&
        validOptionalBoundedString(data.get('contactPhone', null), 32) &&
        validTeamLogoUrl(data.get('logoUrl', null)) &&
        validGuestTeamTournamentIds(data.tournamentIds) &&
        validOptionalDocumentId(data.get('captainGuestPlayerId', null)) &&
        validGuestClaimStatus(data.claimStatus) &&
        validOptionalClaimCode(data.get('claimCode', null)) &&
        validOptionalClaimTokenHash(data.get('activeClaimTokenHash', null)) &&
        validOptionalDocumentId(data.get('linkedTeamId', null)) &&
        validEpochMillis(data.createdAt) &&
        validEpochMillis(data.updatedAt) &&
        data.updatedAt >= data.createdAt;
    }

    function validGuestTeamStatusTransition() {
      return request.resource.data.claimStatus == resource.data.claimStatus ||
        (
          request.resource.data.claimStatus == 'archived' &&
          resource.data.claimStatus == 'guest' &&
          resource.data.get('claimCode', null) == null &&
          resource.data.get('activeClaimTokenHash', null) == null &&
          resource.data.get('linkedTeamId', null) == null
        );
    }

    function validGuestTeamClientUpdate(data, guestTeamId) {
      return data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'normalizedName',
          'contactName',
          'contactPhone',
          'logoUrl',
          'tournamentIds',
          'captainGuestPlayerId',
          'claimStatus',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.normalizedName is string &&
        data.normalizedName.size() > 0 &&
        data.normalizedName.size() <= 180 &&
        validOptionalBoundedString(data.get('contactName', null), 120) &&
        validOptionalBoundedString(data.get('contactPhone', null), 32) &&
        validTeamLogoUrl(data.get('logoUrl', null)) &&
        validGuestTeamTournamentIds(data.tournamentIds) &&
        validOptionalDocumentId(data.get('captainGuestPlayerId', null)) &&
        validGuestClaimStatus(data.claimStatus) &&
        validEpochMillis(data.updatedAt) &&
        data.updatedAt >= resource.data.createdAt &&
        validGuestTeamStatusTransition() &&
        validGuestTeamCaptain(data, guestTeamId);
    }

    function validGuestTeamCaptain(data, guestTeamId) {
      return data.get('captainGuestPlayerId', null) == null ||
        (
          isBoundedDocumentId(data.captainGuestPlayerId) &&
          exists(
            /databases/$(database)/documents/guestPlayers/$(data.captainGuestPlayerId)
          ) &&
          get(
            /databases/$(database)/documents/guestPlayers/$(data.captainGuestPlayerId)
          ).data.guestTeamId == guestTeamId &&
          get(
            /databases/$(database)/documents/guestPlayers/$(data.captainGuestPlayerId)
          ).data.claimStatus != 'archived'
        );
    }

    // captainGuestPlayerId is global guest-team state. Only the authority for
    // the canonical first tournament may change it; later tournaments must
    // keep their roster choices in tournament-scoped documents.
    function canUpdateGuestTeamRosterCaptain() {
      return isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['captainGuestPlayerId', 'updatedAt']) &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.tournamentIds == resource.data.tournamentIds &&
        resource.data.tournamentIds is list &&
        resource.data.tournamentIds.size() > 0 &&
        resource.data.tournamentIds[0] is string &&
        (
          organizesTournamentById(resource.data.tournamentIds[0]) ||
          hasActiveGuestRosterAssistantPermission(
            resource.data.tournamentIds[0]
          )
        );
    }

    function canReadGuestTeam(data) {
      return isAuthenticated() &&
        (
          (data.creatorId is string && data.creatorId == request.auth.uid) ||
          (
            data.tournamentIds is list &&
            'world-cup-2026-simulation' in data.tournamentIds
          ) ||
          canReadGuestTeamByTournamentIds(data.tournamentIds) ||
          canManageGuestRosterByTournamentIds(data.tournamentIds)
        );
    }

    function canReadGuestTeamByTournamentIds(tournamentIds) {
      return tournamentIds is list &&
        (
          (
            tournamentIds.size() > 0 &&
            tournamentIds[0] is string &&
            organizesTournamentById(tournamentIds[0])
          ) ||
          (
            tournamentIds.size() > 1 &&
            tournamentIds[1] is string &&
            organizesTournamentById(tournamentIds[1])
          ) ||
          (
            tournamentIds.size() > 2 &&
            tournamentIds[2] is string &&
            organizesTournamentById(tournamentIds[2])
          ) ||
          (
            tournamentIds.size() > 3 &&
            tournamentIds[3] is string &&
            organizesTournamentById(tournamentIds[3])
          ) ||
          (
            tournamentIds.size() > 4 &&
            tournamentIds[4] is string &&
            organizesTournamentById(tournamentIds[4])
          )
        );
    }

    function canManageGuestRosterByTournamentIds(tournamentIds) {
      return tournamentIds is list &&
        (
          (
            tournamentIds.size() > 0 &&
            tournamentIds[0] is string &&
            hasActiveGuestRosterAssistantPermission(tournamentIds[0])
          ) ||
          (
            tournamentIds.size() > 1 &&
            tournamentIds[1] is string &&
            hasActiveGuestRosterAssistantPermission(tournamentIds[1])
          ) ||
          (
            tournamentIds.size() > 2 &&
            tournamentIds[2] is string &&
            hasActiveGuestRosterAssistantPermission(tournamentIds[2])
          ) ||
          (
            tournamentIds.size() > 3 &&
            tournamentIds[3] is string &&
            hasActiveGuestRosterAssistantPermission(tournamentIds[3])
          ) ||
          (
            tournamentIds.size() > 4 &&
            tournamentIds[4] is string &&
            hasActiveGuestRosterAssistantPermission(tournamentIds[4])
          )
        );
    }

    function hasGuestRosterAssistantPermissionForGuestTeam(
      guestTeamId,
      tournamentId
    ) {
      return isAuthenticated() &&
        guestTeamId is string &&
        tournamentId is string &&
        exists(/databases/$(database)/documents/guestTeams/$(guestTeamId)) &&
        get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
          .data.tournamentIds is list &&
        tournamentId in
          get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
            .data.tournamentIds &&
        hasActiveTournamentAssistantPermission(
          tournamentId,
          'canManageGuestRoster'
        );
    }

    function ownsGuestTeamById(guestTeamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/guestTeams/$(guestTeamId)) &&
        get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
          .data.creatorId == request.auth.uid;
    }

    function canCreateTournamentRegistration(data) {
      return isAuthenticated() &&
        data.tournamentId is string &&
        data.createdBy == request.auth.uid &&
        (
          (
            organizesTournamentById(data.tournamentId) &&
            data.status in ['pending', 'approved', 'rejected'] &&
            (
              data.status == 'pending' ||
              hasOrganizerDecisionByCurrentUser(data)
            )
          ) ||
          (
            ownsTournamentRegistrationSource(data) &&
            data.status == 'pending' &&
            hasNoOrganizerDecisionValues(data)
          )
        );
    }

    function ownsTournamentRegistrationSource(data) {
      return isAuthenticated() && (
        (data.teamId is string && ownsTeamById(data.teamId)) ||
        (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId))
      );
    }

    function hasNoOrganizerDecisionValues(data) {
      return (
          !data.keys().hasAny(['verifiedBy']) ||
          data.verifiedBy == null
        ) &&
        (
          !data.keys().hasAny(['verifiedAt']) ||
          data.verifiedAt == null
        ) &&
        (
          !data.keys().hasAny(['reviewedBy']) ||
          data.reviewedBy == null
        ) &&
        (
          !data.keys().hasAny(['reviewedAt']) ||
          data.reviewedAt == null
        ) &&
        (
          !data.keys().hasAny(['reviewerId']) ||
          data.reviewerId == null
        ) &&
        (
          !data.keys().hasAny(['rejectionReason']) ||
          data.rejectionReason == null
        ) &&
        (
          !data.keys().hasAny(['organizerNote']) ||
          data.organizerNote == null
        );
    }

    function hasOrganizerDecisionByCurrentUser(data) {
      return data.verifiedBy == request.auth.uid &&
        data.verifiedAt is int;
    }

    function registrationImmutableFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'tournamentId',
          'teamId',
          'guestTeamId',
          'claimedFromGuestTeamId',
          'createdBy',
          'submittedBy',
          'createdAt',
          'sourceId',
          'sourceType'
        ]);
    }

    function canSubmitterUpdatePendingTournamentRegistration() {
      return ownsTournamentRegistrationSource(resource.data) &&
        resource.data.status == 'pending' &&
        request.resource.data.status == resource.data.status &&
        registrationImmutableFieldsUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mode', 'notes', 'updatedAt']);
    }

    function canOrganizerDecideTournamentRegistration() {
      return organizesTournamentById(resource.data.tournamentId) &&
        registrationImmutableFieldsUnchanged() &&
        request.resource.data.status in ['approved', 'rejected'] &&
        hasOrganizerDecisionByCurrentUser(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'verifiedBy',
            'verifiedAt',
            'reviewedBy',
            'reviewedAt',
            'reviewerId',
            'rejectionReason',
            'organizerNote',
            'notes',
            'updatedAt'
          ]);
    }

    function canUpdateTournamentRegistration() {
      return isAuthenticated() &&
        resource.data.tournamentId is string &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        (
          canOrganizerDecideTournamentRegistration() ||
          canSubmitterUpdatePendingTournamentRegistration()
        );
    }

    function canReadTournamentRegistration(data) {
      return isAuthenticated() &&
        data.tournamentId is string &&
        (
          data.status == 'approved' ||
          organizesTournamentById(data.tournamentId) ||
          ownsTournamentRegistrationSource(data) ||
          data.createdBy == request.auth.uid
        );
    }

    function canManageMatchdaySide(data) {
      return isAuthenticated() &&
        data.matchId is string &&
        (
          hasActiveAssistantPermissionForMatch(data.matchId, 'canStartMatch') ||
          (
            data.teamId is string &&
            (
              canManageTeamById(data.teamId) ||
              isMatchOrganizerById(data.matchId)
            )
          ) ||
          (
            data.guestTeamId is string &&
            (
              ownsGuestTeamById(data.guestTeamId) ||
              isMatchOrganizerById(data.matchId)
            )
          )
        );
    }

    function canUnlockLineupSnapshot(data) {
      return isAuthenticated() &&
        data.matchId is string &&
        exists(/databases/$(database)/documents/matches/$(data.matchId)) &&
        get(/databases/$(database)/documents/matches/$(data.matchId))
          .data.status in ['open', 'full'] &&
        get(/databases/$(database)/documents/matches/$(data.matchId))
          .data.isFrozen != true &&
        (
          isMatchOrganizerById(data.matchId) ||
          hasActiveAssistantPermissionForMatch(data.matchId, 'canStartMatch')
        );
    }

    function canCreateClaimCode(data) {
      return isAuthenticated() &&
        data.keys().hasOnly([
          'targetType',
          'targetId',
          'scope',
          'teamId',
          'tournamentId',
          'createdBy',
          'requiresApproval',
          'status',
          'createdAt',
          'updatedAt',
          'expiresAt',
          'claimedByPlayerId',
          'claimedAt'
        ]) &&
        data.createdBy == request.auth.uid &&
        data.targetType == 'teamInvite' &&
        data.targetId is string &&
        data.teamId is string &&
        data.targetId == data.teamId &&
        data.scope in ['team', 'tournament', 'hybrid'] &&
        data.requiresApproval == false &&
        data.status == 'active' &&
        data.createdAt is int &&
        data.updatedAt is int &&
        data.expiresAt is int &&
        data.claimedByPlayerId == null &&
        data.claimedAt == null &&
        canManageTeamById(data.teamId);
    }

    function canUpdateClaimCode(data) {
      return isAuthenticated() &&
        data.targetType == 'teamInvite' &&
        data.createdBy == request.auth.uid &&
        canManageTeamById(data.teamId) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.claimedByPlayerId == resource.data.claimedByPlayerId &&
        request.resource.data.claimedAt == resource.data.claimedAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']) &&
        resource.data.status == 'active' &&
        request.resource.data.status == 'expired' &&
        request.resource.data.updatedAt is int;
    }

    function ownsFantasyTeam(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/fantasyTeams/$(teamId)) &&
        get(/databases/$(database)/documents/fantasyTeams/$(teamId))
          .data.ownerPlayerId == request.auth.uid;
    }

    function nullableString(data, key) {
      return data.get(key, null) == null || data.get(key, null) is string;
    }

    function nullableInt(data, key) {
      return data.get(key, null) == null || data.get(key, null) is int;
    }

    function isBoundedDocumentId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    // Firestore Rules cannot iterate over lists, so inspect every supported
    // knockout slot explicitly. Larger brackets must be persisted through a
    // trusted backend operation instead of weakening client-side validation.
    function isBoundedDocumentIdList(value, minSize, maxSize) {
      return value is list &&
        value.size() >= minSize &&
        value.size() <= maxSize &&
        (value.size() <= 0 || isBoundedDocumentId(value[0])) &&
        (value.size() <= 1 || isBoundedDocumentId(value[1])) &&
        (value.size() <= 2 || isBoundedDocumentId(value[2])) &&
        (value.size() <= 3 || isBoundedDocumentId(value[3])) &&
        (value.size() <= 4 || isBoundedDocumentId(value[4])) &&
        (value.size() <= 5 || isBoundedDocumentId(value[5])) &&
        (value.size() <= 6 || isBoundedDocumentId(value[6])) &&
        (value.size() <= 7 || isBoundedDocumentId(value[7])) &&
        (value.size() <= 8 || isBoundedDocumentId(value[8])) &&
        (value.size() <= 9 || isBoundedDocumentId(value[9])) &&
        (value.size() <= 10 || isBoundedDocumentId(value[10])) &&
        (value.size() <= 11 || isBoundedDocumentId(value[11])) &&
        (value.size() <= 12 || isBoundedDocumentId(value[12])) &&
        (value.size() <= 13 || isBoundedDocumentId(value[13])) &&
        (value.size() <= 14 || isBoundedDocumentId(value[14])) &&
        (value.size() <= 15 || isBoundedDocumentId(value[15]));
    }

    function clientMatchDecisionFieldsAreUnset(data) {
      return data.get('penaltyScoreTeamA', null) == null &&
        data.get('penaltyScoreTeamB', null) == null &&
        data.get('knockoutDecision', null) == null;
    }

    function clientMatchDecisionFieldsAreUnchanged() {
      return request.resource.data.get('penaltyScoreTeamA', null) ==
          resource.data.get('penaltyScoreTeamA', null) &&
        request.resource.data.get('penaltyScoreTeamB', null) ==
          resource.data.get('penaltyScoreTeamB', null) &&
        request.resource.data.get('knockoutDecision', null) ==
          resource.data.get('knockoutDecision', null);
    }

    function isAllowedAssistantPermissionName(permissionName) {
      return permissionName in [
        'canViewMatchday',
        'canStartMatch',
        'canSubmitScore',
        'canRecordGoalsAndMvp',
        'canApproveScore',
        'canDeclareForfeit',
        'canManageGuestRoster'
      ];
    }

    function hasActiveTournamentAssistantPermission(tournamentId, permissionName) {
      return isAuthenticated() &&
        isAllowedAssistantPermissionName(permissionName) &&
        exists(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.status == 'active' &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.permissions is map &&
        get(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ).data.permissions.get(permissionName, false) == true;
    }

    function hasActiveGuestRosterAssistantPermission(tournamentId) {
      let assistant = get(
        /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
      );
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/tournaments/$(tournamentId)/assistants/$(request.auth.uid)
        ) &&
        assistant.data.status == 'active' &&
        assistant.data.permissions is map &&
        assistant.data.permissions.get('canManageGuestRoster', false) == true;
    }

    function hasActiveAssistantPermissionForMatch(matchId, permissionName) {
      return isAuthenticated() &&
        matchId is string &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId))
          .data.tournamentId is string &&
        hasActiveTournamentAssistantPermission(
          get(/databases/$(database)/documents/matches/$(matchId))
            .data.tournamentId,
          permissionName
        );
    }

    function isAssistantLineupSnapshotIdUpdate(matchId) {
      return hasActiveAssistantPermissionForMatch(matchId, 'canStartMatch') &&
        resource.data.status in ['open', 'full'] &&
        resource.data.isFrozen != true &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'lineupSnapshotIds',
            'guestLineupSnapshotIds',
            'matchSideLineupSnapshotIds'
          ]) &&
        request.resource.data.get('lineupSnapshotIds', {}) is map &&
        request.resource.data.get('guestLineupSnapshotIds', {}) is map &&
        request.resource.data.get('matchSideLineupSnapshotIds', {}) is map;
    }

    function isOrganizerSafeMatchUpdate() {
      return isMatchOrganizer() &&
        clientMatchDecisionFieldsAreUnchanged() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'scoreTeamA',
            'scoreTeamB',
            'penaltyScoreTeamA',
            'penaltyScoreTeamB',
            'knockoutDecision',
            'mvpPlayerId',
            'prideEventsPending',
            'completedAt',
            'isAnomaly',
            'ratingsAppliedAt'
          ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status']) ||
          request.resource.data.status in [
            'open',
            'full',
            'live',
            'cancelled',
            'frozen'
          ]
        );
    }

    function canReadAuditEvent(data) {
      return isAuthenticated() &&
        (
          data.actorId == request.auth.uid ||
          (
            data.entityType == 'tournament' &&
            data.entityId is string &&
            organizesTournamentById(data.entityId)
          ) ||
          (
            data.entityType == 'match' &&
            data.entityId is string &&
            isMatchOrganizerById(data.entityId)
          ) ||
          (
            data.entityType == 'team' &&
            data.entityId is string &&
            canManageTeamById(data.entityId)
          ) ||
          (
            data.entityType == 'registration' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/tournamentRegistrations/$(data.entityId)) &&
            canReadTournamentRegistration(
              get(/databases/$(database)/documents/tournamentRegistrations/$(data.entityId)).data
            )
          ) ||
          (
            data.entityType == 'tournamentParticipant' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/tournamentParticipants/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/tournamentParticipants/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.entityType == 'tournamentGroup' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/tournamentGroups/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/tournamentGroups/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.entityType == 'groupStandingSnapshot' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/groupStandingSnapshots/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/groupStandingSnapshots/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.entityType == 'knockoutBracket' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/knockoutBrackets/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/knockoutBrackets/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.entityType == 'knockoutTie' &&
            data.entityId is string &&
            exists(/databases/$(database)/documents/knockoutTies/$(data.entityId)) &&
            organizesTournamentById(
              get(/databases/$(database)/documents/knockoutTies/$(data.entityId)).data.tournamentId
            )
          ) ||
          (
            data.metadata is map &&
            data.metadata.tournamentId is string &&
            organizesTournamentById(data.metadata.tournamentId)
          ) ||
          (
            data.metadata is map &&
            data.metadata.matchId is string &&
            isMatchOrganizerById(data.metadata.matchId)
          )
        );
    }

    function validAssistantPermissionMap(permissions) {
      return permissions is map &&
        permissions.keys().hasOnly([
          'canViewMatchday',
          'canStartMatch',
          'canSubmitScore',
          'canRecordGoalsAndMvp',
          'canApproveScore',
          'canDeclareForfeit',
          'canManageGuestRoster'
        ]) &&
        permissions.keys().hasAll([
          'canViewMatchday',
          'canStartMatch',
          'canSubmitScore',
          'canRecordGoalsAndMvp',
          'canApproveScore',
          'canDeclareForfeit',
          'canManageGuestRoster'
        ]) &&
        permissions.canViewMatchday is bool &&
        permissions.canStartMatch is bool &&
        permissions.canSubmitScore is bool &&
        permissions.canRecordGoalsAndMvp is bool &&
        permissions.canApproveScore is bool &&
        permissions.canDeclareForfeit is bool &&
        permissions.canManageGuestRoster is bool;
    }

    function validAssistantPermissionLifecycle(data) {
      return data.status in ['active', 'revoked'] &&
        (
          (
            data.status == 'active' &&
            data.revokedAt == null
          ) ||
          (
            data.status == 'revoked' &&
            data.revokedAt is int
          )
        );
    }

    function validAssistantPermissionDoc(data, tournamentId, assistantUserId) {
      return data.keys().hasOnly([
          'tournamentId',
          'userId',
          'addedBy',
          'status',
          'preset',
          'permissions',
          'createdAt',
          'updatedAt',
          'revokedAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'userId',
          'addedBy',
          'status',
          'preset',
          'permissions',
          'createdAt',
          'updatedAt',
          'revokedAt'
        ]) &&
        data.tournamentId == tournamentId &&
        data.userId == assistantUserId &&
        data.addedBy is string &&
        data.preset in [
          'resultsAssistant',
          'matchdayAssistant',
          'scoreApprover',
          'customLimited'
        ] &&
        data.createdAt is int &&
        data.updatedAt is int &&
        validAssistantPermissionLifecycle(data) &&
        validAssistantPermissionMap(data.permissions);
    }

    function assistantPermissionIdentityUnchanged() {
      return request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.addedBy == resource.data.addedBy &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function canCreateAssistantPermission(tournamentId, assistantUserId) {
      return organizesTournamentById(tournamentId) &&
        assistantUserId != request.auth.uid &&
        validAssistantPermissionDoc(
          request.resource.data,
          tournamentId,
          assistantUserId
        ) &&
        request.resource.data.addedBy == request.auth.uid;
    }

    function canUpdateAssistantPermission(tournamentId, assistantUserId) {
      return organizesTournamentById(tournamentId) &&
        resource.data.tournamentId == tournamentId &&
        resource.data.userId == assistantUserId &&
        validAssistantPermissionDoc(
          request.resource.data,
          tournamentId,
          assistantUserId
        ) &&
        assistantPermissionIdentityUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'preset',
            'permissions',
            'updatedAt',
            'revokedAt'
          ]);
    }

    function canGetAssistantPermission(tournamentId, assistantUserId) {
      return organizesTournamentById(tournamentId) || isOwner(assistantUserId);
    }

    function validTournamentFollower(data, tournamentId, followerUserId) {
      return data.keys().hasOnly([
          'tournamentId',
          'userId',
          'createdAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'userId',
          'createdAt'
        ]) &&
        data.tournamentId == tournamentId &&
        data.userId == followerUserId &&
        data.createdAt is int;
    }

    function validOrganizerTournamentMembership(data, membershipId) {
      return data.keys().hasOnly([
          'tournamentId',
          'userId',
          'role',
          'createdAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'userId',
          'role',
          'createdAt'
        ]) &&
        isBoundedDocumentId(data.tournamentId) &&
        data.userId == request.auth.uid &&
        data.role == 'organizer' &&
        data.createdAt is int &&
        data.createdAt > 0 &&
        membershipId == request.auth.uid + '_' + data.tournamentId &&
        getAfter(
          /databases/$(database)/documents/tournaments/$(data.tournamentId)
        ).data.organizerId == request.auth.uid;
    }

    function hasMatchingOrganizerMembershipAfter(tournamentId) {
      let membershipId = request.auth.uid + '_' + tournamentId;
      let membership = getAfter(
          /databases/$(database)/documents/tournamentMemberships/$(membershipId)
        ).data;
      return membership.tournamentId == tournamentId &&
        membership.userId == request.auth.uid &&
        membership.role == 'organizer';
    }

    function canReadOwnFollowerDocument(followerUserId) {
      return isOwner(followerUserId) &&
        resource.data.userId is string &&
        resource.data.userId == request.auth.uid;
    }

    function ownsTournamentOperation(data) {
      return data.tournamentId is string &&
        organizesTournamentById(data.tournamentId);
    }

    function ownsExistingTournamentOperation() {
      return resource.data.tournamentId is string &&
        organizesTournamentById(resource.data.tournamentId);
    }

    function tournamentOperationRefsUnchanged() {
      return request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function canManageMatchOperationById(matchId) {
      return isAuthenticated() &&
        matchId is string &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId))
          .data.organizerId == request.auth.uid;
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    function isOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    function validChallengeDoc(data) {
      return data.keys().hasOnly([
          'challengerId',
          'challengedId',
          'challengerTeamId',
          'challengedTeamId',
          'matchId',
          'status',
          'message',
          'location',
          'teamSize',
          'createdAt',
          'respondedAt',
          'expiresAt'
        ]) &&
        data.keys().hasAll([
          'challengerId',
          'challengedId',
          'status',
          'teamSize',
          'createdAt',
          'expiresAt'
        ]) &&
        data.challengerId is string &&
        data.challengedId is string &&
        data.challengerId != data.challengedId &&
        isOptionalString(data.challengerTeamId) &&
        isOptionalString(data.challengedTeamId) &&
        isOptionalString(data.matchId) &&
        data.status in ['pending', 'accepted', 'declined', 'expired', 'cancelled'] &&
        data.teamSize is int &&
        data.teamSize >= 5 &&
        data.teamSize <= 11 &&
        data.createdAt is timestamp &&
        isOptionalTimestamp(data.respondedAt) &&
        data.expiresAt is timestamp &&
        data.expiresAt > data.createdAt &&
        isOptionalString(data.message) &&
        isOptionalString(data.location);
    }

    function isChallengeParticipant(data) {
      return isAuthenticated() &&
        (
          data.challengerId == request.auth.uid ||
          data.challengedId == request.auth.uid
        );
    }

    function challengeIdentityUnchanged() {
      return request.resource.data.challengerId == resource.data.challengerId &&
        request.resource.data.challengedId == resource.data.challengedId &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function canCreateChallenge(data) {
      return isAuthenticated() &&
        validChallengeDoc(data) &&
        data.challengerId == request.auth.uid &&
        data.status == 'pending' &&
        data.matchId == null &&
        data.respondedAt == null;
    }

    function canUpdateChallenge(challengeId) {
      return isChallengeParticipant(resource.data) &&
        validChallengeDoc(request.resource.data) &&
        resource.data.status == 'pending' &&
        challengeIdentityUnchanged() &&
        request.resource.data.respondedAt is timestamp &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondedAt', 'matchId']) &&
        (
          (
            request.resource.data.status == 'cancelled' &&
            resource.data.challengerId == request.auth.uid &&
            request.resource.data.matchId == resource.data.matchId
          ) ||
          (
            request.resource.data.status in ['declined', 'expired'] &&
            resource.data.challengedId == request.auth.uid &&
            request.resource.data.matchId == resource.data.matchId
          ) ||
          (
            request.resource.data.status == 'accepted' &&
            resource.data.challengedId == request.auth.uid &&
            request.resource.data.matchId == challengeId &&
            exists(/databases/$(database)/documents/matches/$(challengeId)) &&
            get(/databases/$(database)/documents/matches/$(challengeId))
              .data.challengeId == challengeId
          )
        );
    }

    function validChallengeBackedMatchDoc(data) {
      return data.keys().hasOnly([
          'organizerId',
          'teamAId',
          'teamBId',
          'teamAPlayerIds',
          'teamBPlayerIds',
          'teamAParticipantId',
          'teamBParticipantId',
          'status',
          'scoreTeamA',
          'scoreTeamB',
          'mvpPlayerId',
          'location',
          'latitude',
          'longitude',
          'teamSize',
          'isOrganized',
          'tournamentId',
          'challengeId',
          'isGoldenRating',
          'isAnomaly',
          'isFrozen',
          'stageType',
          'groupId',
          'groupStageId',
          'knockoutTieId',
          'roundIndex',
          'slotNumber',
          'scheduledAt',
          'publishedAt',
          'venueId',
          'fixtureStatus',
          'lineupRequirement',
          'createdAt',
          'startedAt',
          'completedAt',
          'cancelledAt',
          'cancelledBy',
          'cancelReason'
        ]) &&
        data.organizerId is string &&
        data.status is string &&
        data.teamAPlayerIds is list &&
        data.teamBPlayerIds is list &&
        data.teamSize is int &&
        data.isOrganized is bool &&
        (
          !data.keys().hasAny(['teamAId']) ||
          data.teamAId is string ||
          data.teamAId == null
        ) &&
        (
          !data.keys().hasAny(['teamBId']) ||
          data.teamBId is string ||
          data.teamBId == null
        );
    }

    function canCreateAcceptedChallengeMatch(data, matchId) {
      return data.challengeId is string &&
        data.challengeId == matchId &&
        validChallengeBackedMatchDoc(data) &&
        exists(/databases/$(database)/documents/challenges/$(data.challengeId)) &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.status == 'pending' &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.matchId == null &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.expiresAt > request.time &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.challengedId == request.auth.uid &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.challengerId == data.organizerId &&
        data.status == 'open' &&
        data.isOrganized == false &&
        data.tournamentId == null &&
        data.teamAPlayerIds is list &&
        data.teamBPlayerIds is list &&
        get(/databases/$(database)/documents/challenges/$(data.challengeId))
          .data.challengerId in data.teamAPlayerIds &&
        request.auth.uid in data.teamBPlayerIds &&
        (
          !(get(/databases/$(database)/documents/challenges/$(data.challengeId))
            .data.challengerTeamId is string) ||
          data.teamAId == get(/databases/$(database)/documents/challenges/$(data.challengeId))
            .data.challengerTeamId
        ) &&
        (
          !(get(/databases/$(database)/documents/challenges/$(data.challengeId))
            .data.challengedTeamId is string) ||
          data.teamBId == get(/databases/$(database)/documents/challenges/$(data.challengeId))
            .data.challengedTeamId
        );
    }

    function canCreateMatch(data, matchId) {
      return isAuthenticated() &&
        clientMatchDecisionFieldsAreUnset(data) &&
        (
          data.organizerId == request.auth.uid ||
          canCreateAcceptedChallengeMatch(data, matchId)
        );
    }

    function validMatchInvitationDoc(data) {
      return data.keys().hasOnly([
          'matchId',
          'senderId',
          'receiverId',
          'side',
          'status',
          'createdAt',
          'respondedAt'
        ]) &&
        data.keys().hasAll([
          'matchId',
          'senderId',
          'receiverId',
          'side',
          'status',
          'createdAt'
        ]) &&
        data.matchId is string &&
        data.senderId is string &&
        data.receiverId is string &&
        data.senderId != data.receiverId &&
        data.side in ['A', 'B'] &&
        data.status in ['pending', 'accepted', 'declined', 'cancelled'] &&
        data.createdAt is timestamp &&
        isOptionalTimestamp(data.respondedAt);
    }

    function matchInvitationIdentityUnchanged() {
      return request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function canCreateMatchInvitation(data) {
      return isAuthenticated() &&
        validMatchInvitationDoc(data) &&
        data.senderId == request.auth.uid &&
        data.status == 'pending' &&
        data.respondedAt == null;
    }

    function canUpdateMatchInvitation() {
      return isAuthenticated() &&
        validMatchInvitationDoc(request.resource.data) &&
        resource.data.status == 'pending' &&
        matchInvitationIdentityUnchanged() &&
        request.resource.data.respondedAt is timestamp &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondedAt']) &&
        (
          (
            request.resource.data.status == 'cancelled' &&
            resource.data.senderId == request.auth.uid
          ) ||
          (
            request.resource.data.status in ['accepted', 'declined'] &&
            resource.data.receiverId == request.auth.uid
          )
        );
    }

    function canCreateReservedUsername(data, docId) {
      return isAuthenticated() &&
        data.keys().hasOnly([
          'username',
          'ownerId',
          'previousOwnerId',
          'status',
          'claimedAt',
          'reservedAt',
          'expiresAt'
        ]) &&
        data.username is string &&
        data.username == docId &&
        data.ownerId is string &&
        data.ownerId == request.auth.uid;
    }

    function canClaimExpiredReservedUsername() {
      return resource.data.status == 'reserved' &&
        resource.data.expiresAt is int &&
        resource.data.expiresAt <= request.time.toMillis();
    }

    function canUpdateReservedUsername() {
      return isAuthenticated() &&
        (
          resource.data.ownerId == request.auth.uid ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
              'ownerId',
              'status',
              'claimedAt',
              'expiresAt'
            ]) &&
            request.resource.data.ownerId is string &&
            request.resource.data.ownerId == request.auth.uid &&
            request.resource.data.status == 'active' &&
            request.resource.data.claimedAt is int &&
            request.resource.data.expiresAt == null &&
            canClaimExpiredReservedUsername()
          )
        );
    }

    function matchOperationRefsUnchanged() {
      return request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.sideKey == resource.data.sideKey &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function validTournamentParticipant(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'sourceType',
          'sourceEntityId',
          'displayName',
          'status',
          'seed',
          'groupId',
          'sourceRegistrationId',
          'replacementForParticipantId',
          'replacedByParticipantId',
          'createdAt',
          'updatedAt',
          'approvedAt',
          'finalizedAt',
          'withdrawnAt',
          'replacedAt'
        ]) &&
        data.tournamentId is string &&
        data.sourceType in ['registeredTeam', 'guestTeam'] &&
        data.sourceEntityId is string &&
        data.displayName is string &&
        data.status in ['approved', 'finalized', 'withdrawn', 'replaced'] &&
        nullableInt(data, 'seed') &&
        nullableString(data, 'groupId') &&
        nullableString(data, 'sourceRegistrationId') &&
        nullableString(data, 'replacementForParticipantId') &&
        nullableString(data, 'replacedByParticipantId') &&
        data.createdAt is int &&
        data.updatedAt is int &&
        nullableInt(data, 'approvedAt') &&
        nullableInt(data, 'finalizedAt') &&
        nullableInt(data, 'withdrawnAt') &&
        nullableInt(data, 'replacedAt');
    }

    function participantSourceRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.sourceType == resource.data.sourceType &&
        request.resource.data.sourceEntityId == resource.data.sourceEntityId;
    }

    function validTournamentGroup(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'groupStageId',
          'name',
          'order',
          'participantIds',
          'qualifierParticipantIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.tournamentId is string &&
        data.groupStageId is string &&
        data.name is string &&
        data.order is int &&
        data.participantIds is list &&
        data.qualifierParticipantIds is list &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function groupRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.groupStageId == resource.data.groupStageId;
    }

    function validGroupStandingSnapshot(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'groupStageId',
          'groupId',
          'tiebreakerOrder',
          'entries',
          'qualifierParticipantIds',
          'createdAt',
          'updatedAt'
        ]) &&
        data.tournamentId is string &&
        data.groupStageId is string &&
        data.groupId is string &&
        data.tiebreakerOrder is list &&
        data.entries is list &&
        data.qualifierParticipantIds is list &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function standingRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.groupStageId == resource.data.groupStageId &&
        request.resource.data.groupId == resource.data.groupId;
    }

    function validKnockoutBracket(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'seedingMethod',
          'byeParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'seedingMethod',
          'byeParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        isBoundedDocumentId(data.tournamentId) &&
        data.format == 'singleElimination' &&
        isBoundedDocumentIdList(data.qualifierParticipantIds, 2, 16) &&
        data.qualifierParticipantIds.toSet().size() ==
          data.qualifierParticipantIds.size() &&
        data.seedingMethod in ['ranked', 'draw', 'groupCrossPairing'] &&
        isBoundedDocumentIdList(data.byeParticipantIds, 0, 15) &&
        data.byeParticipantIds.toSet().size() ==
          data.byeParticipantIds.size() &&
        data.byeParticipantIds.toSet()
          .difference(data.qualifierParticipantIds.toSet()).size() == 0 &&
        (
          data.championParticipantId == null ||
          (
            isBoundedDocumentId(data.championParticipantId) &&
            data.championParticipantId in data.qualifierParticipantIds
          )
        ) &&
        data.createdAt is int && data.createdAt >= 0 &&
        data.updatedAt is int && data.updatedAt >= data.createdAt;
    }

    function validKnockoutBracketCreate(data) {
      return validKnockoutBracket(data) &&
        data.championParticipantId == null;
    }

    function validKnockoutBracketClientUpdate() {
      // The participant lists were deeply validated on create and are
      // immutable here. Re-validating them on every update can exceed the
      // Firestore Rules expression budget, so validate the only mutable field
      // and lock the complete persisted structure instead.
      return request.resource.data.keys().hasOnly([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'seedingMethod',
          'byeParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'tournamentId',
          'format',
          'qualifierParticipantIds',
          'seedingMethod',
          'byeParticipantIds',
          'championParticipantId',
          'createdAt',
          'updatedAt'
        ]) &&
        tournamentOperationRefsUnchanged() &&
        request.resource.data.format == resource.data.format &&
        request.resource.data.qualifierParticipantIds ==
          resource.data.qualifierParticipantIds &&
        request.resource.data.seedingMethod == resource.data.seedingMethod &&
        request.resource.data.byeParticipantIds ==
          resource.data.byeParticipantIds &&
        request.resource.data.championParticipantId ==
          resource.data.championParticipantId &&
        request.resource.data.updatedAt is int &&
        request.resource.data.updatedAt >= resource.data.updatedAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt']);
    }

    function validKnockoutTie(data) {
      return data.keys().hasOnly([
          'tournamentId',
          'bracketId',
          'roundIndex',
          'slotNumber',
          'participantAId',
          'participantBId',
          'winnerParticipantId',
          'matchId',
          'nextTieId',
          'resolutionType',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'tournamentId',
          'bracketId',
          'roundIndex',
          'slotNumber',
          'participantAId',
          'participantBId',
          'winnerParticipantId',
          'matchId',
          'nextTieId',
          'resolutionType',
          'createdAt',
          'updatedAt'
        ]) &&
        isBoundedDocumentId(data.tournamentId) &&
        isBoundedDocumentId(data.bracketId) &&
        data.roundIndex is int &&
        data.roundIndex >= 0 && data.roundIndex <= 15 &&
        data.slotNumber is int &&
        data.slotNumber >= 0 && data.slotNumber <= 32767 &&
        (
          data.participantAId == null ||
          isBoundedDocumentId(data.participantAId)
        ) &&
        (
          data.participantBId == null ||
          isBoundedDocumentId(data.participantBId)
        ) &&
        (
          data.winnerParticipantId == null ||
          isBoundedDocumentId(data.winnerParticipantId)
        ) &&
        (data.matchId == null || isBoundedDocumentId(data.matchId)) &&
        (data.nextTieId == null || isBoundedDocumentId(data.nextTieId)) &&
        data.resolutionType in [
          'pending',
          'regularTime',
          'penalties',
          'bye'
        ] &&
        data.createdAt is int && data.createdAt >= 0 &&
        data.updatedAt is int && data.updatedAt >= data.createdAt &&
        validKnockoutTieResolutionState(data);
    }

    function validKnockoutTieResolutionState(data) {
      return (
          data.resolutionType == 'pending' &&
          data.winnerParticipantId == null &&
          isBoundedDocumentId(data.matchId)
        ) ||
        (
          data.resolutionType == 'bye' &&
          data.roundIndex == 0 &&
          data.matchId == null &&
          (
            (
              isBoundedDocumentId(data.participantAId) &&
              data.participantBId == null &&
              data.winnerParticipantId == data.participantAId
            ) ||
            (
              data.participantAId == null &&
              isBoundedDocumentId(data.participantBId) &&
              data.winnerParticipantId == data.participantBId
            )
          )
        ) ||
        (
          data.resolutionType in ['regularTime', 'penalties'] &&
          isBoundedDocumentId(data.participantAId) &&
          isBoundedDocumentId(data.participantBId) &&
          isBoundedDocumentId(data.matchId) &&
          data.winnerParticipantId in [
            data.participantAId,
            data.participantBId
          ]
        );
    }

    function validKnockoutTieCreate(data) {
      return validKnockoutTie(data) &&
        data.resolutionType in ['pending', 'bye'];
    }

    function validKnockoutTieClientUpdate() {
      return validKnockoutTie(request.resource.data) &&
        tieRefsUnchanged() &&
        request.resource.data.updatedAt >= resource.data.updatedAt &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt']);
    }

    function tieRefsUnchanged() {
      return tournamentOperationRefsUnchanged() &&
        request.resource.data.bracketId == resource.data.bracketId;
    }

    function validMatchSide(data) {
      return data.keys().hasOnly([
          'matchId',
          'sideKey',
          'type',
          'displayName',
          'officialTeamId',
          'captainUserId',
          'managedByUserIds',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.matchId is string &&
        data.sideKey in ['A', 'B'] &&
        data.type in ['temporary', 'officialTeam'] &&
        data.displayName is string &&
        nullableString(data, 'officialTeamId') &&
        nullableString(data, 'captainUserId') &&
        data.managedByUserIds is list &&
        data.createdBy is string &&
        data.createdAt is int &&
        data.updatedAt is int;
    }

    function validMatchSidePlayer(data) {
      return data.keys().hasOnly([
          'matchId',
          'sideKey',
          'sideId',
          'kind',
          'playerId',
          'displayName',
          'position',
          'shirtNumber',
          'ratingEligible',
          'addedBy',
          'createdAt'
        ]) &&
        data.matchId is string &&
        data.sideKey in ['A', 'B'] &&
        data.sideId is string &&
        data.kind in ['temporary', 'registered'] &&
        nullableString(data, 'playerId') &&
        data.displayName is string &&
        nullableString(data, 'position') &&
        nullableInt(data, 'shirtNumber') &&
        data.ratingEligible is bool &&
        data.addedBy is string &&
        data.createdAt is int;
    }

    // Temporary Wave 0 bootstrap contract. Wave 2 replaces this client create
    // with ensurePlayerProfile(), then this allowance is removed entirely.
    function validInitialPlayerProfile(data, playerId) {
      return data.keys().hasOnly([
          'name',
          'nameLower',
          'username',
          'usernameLower',
          'photoUrl',
          'photoThumbUrl',
          'photoFrame',
          'qrCode',
          'phone',
          'position',
          'rating',
          'totalMatches',
          'wins',
          'draws',
          'losses',
          'mvpCount',
          'trustWeight',
          'trustLevel',
          'role',
          'achievementIds',
          'teamIds',
          'friendIds',
          'followingIds',
          'blockedIds',
          'privacySetting',
          'isGuest',
          'createdAt',
          'lastActiveAt'
        ]) &&
        data.keys().hasAll([
          'name',
          'nameLower',
          'username',
          'usernameLower',
          'photoUrl',
          'photoThumbUrl',
          'photoFrame',
          'qrCode',
          'phone',
          'position',
          'rating',
          'totalMatches',
          'wins',
          'draws',
          'losses',
          'mvpCount',
          'trustWeight',
          'trustLevel',
          'role',
          'achievementIds',
          'teamIds',
          'friendIds',
          'followingIds',
          'blockedIds',
          'privacySetting',
          'isGuest',
          'createdAt',
          'lastActiveAt'
        ]) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.nameLower is string &&
        data.nameLower.size() > 0 &&
        data.nameLower.size() <= 120 &&
        data.username == null &&
        data.usernameLower == null &&
        (
          data.photoUrl == null ||
          (
            data.photoUrl is string &&
            data.photoUrl.size() <= 2048 &&
            data.photoUrl.matches('^https://[^ ]+$')
          )
        ) &&
        data.photoThumbUrl == null &&
        data.photoFrame == 'newcomer' &&
        data.qrCode == '7reef://player/' + playerId &&
        (
          data.phone == null ||
          (data.phone is string && data.phone.size() <= 32)
        ) &&
        data.position == null &&
        data.rating == 1000 &&
        data.totalMatches == 0 &&
        data.wins == 0 &&
        data.draws == 0 &&
        data.losses == 0 &&
        data.mvpCount == 0 &&
        data.trustWeight == 0.5 &&
        data.trustLevel == 'newPlayer' &&
        data.role == 'player' &&
        data.achievementIds is list &&
        data.achievementIds.size() == 0 &&
        data.teamIds is list &&
        data.teamIds.size() == 0 &&
        data.friendIds is list &&
        data.friendIds.size() == 0 &&
        data.followingIds is list &&
        data.followingIds.size() == 0 &&
        data.blockedIds is list &&
        data.blockedIds.size() == 0 &&
        data.privacySetting == 'public' &&
        data.isGuest == false &&
        data.createdAt is int &&
        data.lastActiveAt is int &&
        data.createdAt == data.lastActiveAt &&
        data.createdAt >= request.time.toMillis() - 300000 &&
        data.createdAt <= request.time.toMillis() + 300000;
    }

    function clientBlockedIdsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['blockedIds']);
    }

    function validPlayerRelationshipLists(data) {
      return data.friendIds is list &&
        data.friendIds.size() <= 1000 &&
        data.followingIds is list &&
        data.followingIds.size() <= 1000 &&
        data.blockedIds is list &&
        data.blockedIds.size() <= 1000;
    }

    function validPlayerRelationshipListChanges() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
          !changed.hasAny(['friendIds']) ||
          (
            request.resource.data.friendIds is list &&
            request.resource.data.friendIds.size() <= 1000
          )
        ) &&
        (
          !changed.hasAny(['followingIds']) ||
          (
            request.resource.data.followingIds is list &&
            request.resource.data.followingIds.size() <= 1000
          )
        ) &&
        (
          !changed.hasAny(['blockedIds']) ||
          (
            request.resource.data.blockedIds is list &&
            request.resource.data.blockedIds.size() <= 1000
          )
        );
    }

    function validClientFriendship(data, friendshipId) {
      return data.keys().hasAll([
          'userId1',
          'userId2',
          'participants',
          'status',
          'lastActionBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId1',
          'userId2',
          'participants',
          'status',
          'lastActionBy',
          'createdAt',
          'updatedAt'
        ]) &&
        isBoundedDocumentId(data.userId1) &&
        isBoundedDocumentId(data.userId2) &&
        data.userId1 != data.userId2 &&
        data.userId1 < data.userId2 &&
        friendshipId == data.userId1 + '_' + data.userId2 &&
        data.participants is list &&
        data.participants.size() == 2 &&
        data.participants == [data.userId1, data.userId2] &&
        data.status in ['pending', 'accepted'] &&
        data.lastActionBy in data.participants &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function playerDoesNotBlock(playerId, otherPlayerId) {
      return exists(/databases/$(database)/documents/players/$(playerId)) &&
        get(/databases/$(database)/documents/players/$(playerId))
          .data.get('blockedIds', []) is list &&
        !(otherPlayerId in get(
          /databases/$(database)/documents/players/$(playerId)
        ).data.get('blockedIds', []));
    }

    function friendshipPairIsUnblocked(data) {
      return playerDoesNotBlock(data.userId1, data.userId2) &&
        playerDoesNotBlock(data.userId2, data.userId1);
    }

    function validClientFriendshipCreate(data, friendshipId) {
      return validClientFriendship(data, friendshipId) &&
        data.status == 'pending' &&
        data.lastActionBy == request.auth.uid &&
        friendshipPairIsUnblocked(data);
    }

    function validClientFriendshipAcceptance(data, friendshipId) {
      return validClientFriendship(data, friendshipId) &&
        friendshipIdentityUnchanged() &&
        friendshipPairIsUnblocked(data) &&
        resource.data.status == 'pending' &&
        data.status == 'accepted' &&
        resource.data.lastActionBy != request.auth.uid &&
        data.lastActionBy == request.auth.uid;
    }

    function friendshipIdentityUnchanged() {
      return request.resource.data.userId1 == resource.data.userId1 &&
        request.resource.data.userId2 == resource.data.userId2 &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function matchSidePlayerRefsUnchanged() {
      return matchOperationRefsUnchanged() &&
        request.resource.data.sideId == resource.data.sideId &&
        request.resource.data.kind == resource.data.kind &&
        request.resource.data.addedBy == resource.data.addedBy;
    }

    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(playerId) &&
        validInitialPlayerProfile(request.resource.data, playerId) &&
        validPlayerRelationshipLists(request.resource.data);
      allow update: if isOwner(playerId) &&
        validPlayerRelationshipListChanges() &&
        clientBlockedIdsUnchanged() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'rating',
            'totalMatches',
            'wins',
            'draws',
            'losses',
            'mvpCount',
            'trustWeight',
            'trustLevel',
            'role',
            'isGuest',
            'createdAt'
          ]);
      allow delete: if false;
    }

    match /guestPlayers/{guestPlayerId} {
      allow read: if canManageGuestPlayer(resource.data) ||
        isLinkedGuestPlayer(resource.data);
      allow create: if canCreateGuestPlayer(request.resource.data);
      allow update: if (
        canManageGuestPlayer(resource.data) &&
        validGuestPlayerDocument(request.resource.data) &&
        guestPlayerSourceFieldsUnchanged() &&
        guestPlayerAuthorityFieldsUnchanged() &&
        validGuestPlayerStatusTransition()
      );
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        validTeamLogoUrl(request.resource.data.get('logoUrl', null));
      allow update: if (
        isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['logoUrl']) ||
          validTeamLogoUrl(request.resource.data.get('logoUrl', null))
        )
      ) ||
        (
          canManageTeamById(teamId) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['logoUrl']) &&
          validTeamPresetLogoUrl(request.resource.data.get('logoUrl', null))
        );
      allow delete: if false;
    }

    function validInitialClientTeamMembershipIdentity(data) {
      return data.get('claimedFromGuestPlayerId', null) == null &&
        (
          (
            isBoundedDocumentId(data.get('playerId', null)) &&
            data.get('guestPlayerId', null) == null
          ) ||
          (
            data.get('playerId', null) == null &&
            isBoundedDocumentId(data.get('guestPlayerId', null))
          )
        );
    }

    function validTeamMembershipDocument(data) {
      return data.keys().hasOnly([
          'teamId',
          'playerId',
          'guestPlayerId',
          'claimedFromGuestPlayerId',
          'role',
          'status',
          'availability',
          'joinedAt',
          'updatedAt',
          'invitedBy'
        ]) &&
        data.keys().hasAll([
          'teamId',
          'role',
          'status',
          'availability',
          'joinedAt',
          'updatedAt'
        ]) &&
        isBoundedDocumentId(data.teamId) &&
        validOptionalDocumentId(data.get('playerId', null)) &&
        validOptionalDocumentId(data.get('guestPlayerId', null)) &&
        validOptionalDocumentId(data.get('claimedFromGuestPlayerId', null)) &&
        data.role in [
          'owner',
          'viceCaptain',
          'player',
          'manager',
          'assistantManager'
        ] &&
        data.status in ['starter', 'bench', 'inactive'] &&
        data.availability in [
          'available',
          'unavailable',
          'injured',
          'pending'
        ] &&
        validEpochMillis(data.joinedAt) &&
        validEpochMillis(data.updatedAt) &&
        data.updatedAt >= data.joinedAt &&
        validOptionalDocumentId(data.get('invitedBy', null));
    }

    function teamMembershipIdentityUnchanged() {
      return request.resource.data.get('playerId', null) ==
          resource.data.get('playerId', null) &&
        request.resource.data.get('guestPlayerId', null) ==
          resource.data.get('guestPlayerId', null) &&
        request.resource.data.get('claimedFromGuestPlayerId', null) ==
          resource.data.get('claimedFromGuestPlayerId', null);
    }

    function teamMembershipSourceFieldsUnchanged() {
      return request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.joinedAt == resource.data.joinedAt &&
        request.resource.data.get('invitedBy', null) ==
          resource.data.get('invitedBy', null);
    }

    match /teamMemberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId) &&
        validTeamMembershipDocument(request.resource.data) &&
        validInitialClientTeamMembershipIdentity(request.resource.data);
      allow update: if (
        isAuthenticated() &&
        canManageTeamById(resource.data.teamId) &&
        validTeamMembershipDocument(request.resource.data) &&
        teamMembershipSourceFieldsUnchanged() &&
        teamMembershipIdentityUnchanged()
      );
      allow delete: if false;
    }

    match /teamFormationTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId);
      allow update: if isAuthenticated() &&
        canManageTeamById(resource.data.teamId) &&
        request.resource.data.teamId == resource.data.teamId;
      allow delete: if isAuthenticated() &&
        canManageTeamById(resource.data.teamId);
    }

    match /teamRosterSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId);
      allow update, delete: if false;
    }

    match /guestTeams/{guestTeamId} {
      allow read: if canReadGuestTeam(resource.data);
      allow create: if canManageGuestTeam(request.resource.data) &&
        validInitialGuestTeam(request.resource.data);
      allow update: if (
          canManageGuestTeam(resource.data) ||
          canUpdateGuestTeamRosterCaptain()
        ) &&
        validGuestTeamClientUpdate(request.resource.data, guestTeamId);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if canCreateMatch(request.resource.data, matchId);
      allow update: if isOrganizerSafeMatchUpdate() ||
        isAssistantLineupSnapshotIdUpdate(matchId);
      allow delete: if false;

      match /player_stats/{playerId} {
        allow read: if isAuthenticated();
        allow create, update: if false;
        allow delete: if false;
      }

      match /pendingPrideEvents/{payloadId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if false;
      }
    }

    match /matchEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create, update: if false;
      allow delete: if false;
    }

    match /matchCheckIns/{checkInId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update: if (
        canManageMatchdaySide(resource.data) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.guestTeamId == resource.data.guestTeamId
      );
      allow delete: if false;
    }

    match /matchAttendances/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update: if (
        canManageMatchdaySide(resource.data) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.guestTeamId == resource.data.guestTeamId
      );
      allow delete: if false;
    }

    match /matchLineupSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update: if false;
      allow delete: if canUnlockLineupSnapshot(resource.data);
    }

    match /matchSubstitutions/{substitutionId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update, delete: if false;
    }

    match /{path=**}/followers/{followerUserId} {
      allow get: if canReadOwnFollowerDocument(followerUserId);
      allow list: if isAuthenticated() &&
        resource.data.userId is string &&
        resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /tournaments/{tournamentId} {
      allow get: if isAuthenticated() &&
        (
          isPublicTournament(resource.data) ||
          canReadPrivateTournament(resource.data, tournamentId)
        );
      allow list: if canListTournament(resource.data);
      allow create: if isAuthenticated() &&
        request.resource.data.organizerId == request.auth.uid &&
        validTournamentDocument(request.resource.data) &&
        createsUnfeaturedTournament(request.resource.data) &&
        hasMatchingOrganizerMembershipAfter(tournamentId);
      allow update: if isTournamentOrganizer() &&
        validTournamentDocument(request.resource.data) &&
        preservesTournamentAuthorityAndPromotion();
      allow delete: if false;

      match /assistants/{assistantUserId} {
        allow get: if canGetAssistantPermission(tournamentId, assistantUserId);
        allow list: if organizesTournamentById(tournamentId);
        allow create: if canCreateAssistantPermission(
          tournamentId,
          assistantUserId
        );
        allow update: if canUpdateAssistantPermission(
          tournamentId,
          assistantUserId
        );
        allow delete: if false;
      }

      match /followers/{followerUserId} {
        allow get: if isOwner(followerUserId) ||
          organizesTournamentById(tournamentId);
        allow list: if isAuthenticated() &&
          (
            organizesTournamentById(tournamentId) ||
            resource.data.userId == request.auth.uid
          );
        allow create: if isOwner(followerUserId) &&
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId))
            .data.organizerId != request.auth.uid &&
          validTournamentFollower(
            request.resource.data,
            tournamentId,
            followerUserId
          );
        allow update: if false;
        allow delete: if isOwner(followerUserId);
      }
    }

    match /tournamentRegistrations/{registrationId} {
      allow read: if canReadTournamentRegistration(resource.data);
      allow create: if canCreateTournamentRegistration(request.resource.data);
      allow update: if canUpdateTournamentRegistration();
      allow delete: if false;
    }

    match /tournamentMemberships/{membershipId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        validOrganizerTournamentMembership(
          request.resource.data,
          membershipId
        );
      allow update, delete: if false;
    }

    match /tournamentParticipants/{participantId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validTournamentParticipant(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        participantSourceRefsUnchanged() &&
        validTournamentParticipant(request.resource.data);
      allow delete: if ownsExistingTournamentOperation();
    }

    match /publicTournamentRosterEntries/{entryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /tournamentGroups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validTournamentGroup(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        groupRefsUnchanged() &&
        validTournamentGroup(request.resource.data);
      allow delete: if ownsExistingTournamentOperation();
    }

    match /groupStandingSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validGroupStandingSnapshot(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        standingRefsUnchanged() &&
        validGroupStandingSnapshot(request.resource.data);
      allow delete: if ownsExistingTournamentOperation();
    }

    match /knockoutBrackets/{bracketId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validKnockoutBracketCreate(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        validKnockoutBracketClientUpdate();
      allow delete: if false;
    }

    match /knockoutTies/{tieId} {
      allow read: if isAuthenticated();
      allow create: if ownsTournamentOperation(request.resource.data) &&
        validKnockoutTieCreate(request.resource.data);
      allow update: if ownsExistingTournamentOperation() &&
        validKnockoutTieClientUpdate();
      allow delete: if false;
    }

    match /matchSides/{sideId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchOperationById(
          request.resource.data.matchId
        ) &&
        validMatchSide(request.resource.data);
      allow update: if canManageMatchOperationById(resource.data.matchId) &&
        matchOperationRefsUnchanged() &&
        validMatchSide(request.resource.data);
      allow delete: if false;
    }

    match /matchSidePlayers/{playerId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchOperationById(
          request.resource.data.matchId
        ) &&
        validMatchSidePlayer(request.resource.data);
      allow update: if canManageMatchOperationById(resource.data.matchId) &&
        matchSidePlayerRefsUnchanged() &&
        validMatchSidePlayer(request.resource.data);
      allow delete: if canManageMatchOperationById(resource.data.matchId);
    }

    match /ratingEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /encounterLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /organizerActions/{actionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /challenges/{challengeId} {
      allow read: if isChallengeParticipant(resource.data);
      allow create: if canCreateChallenge(request.resource.data);
      allow update: if canUpdateChallenge(challengeId);
      allow delete: if false;
    }

    match /matchInvitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create: if canCreateMatchInvitation(request.resource.data);
      allow update: if canUpdateMatchInvitation();
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isParticipant(resource.data.participants);
      allow create: if validClientFriendshipCreate(
          request.resource.data,
          friendshipId
        );
      allow update: if isParticipant(resource.data.participants) &&
        resource.data.status != 'blocked' &&
        validClientFriendshipAcceptance(
          request.resource.data,
          friendshipId
        );
      allow delete: if isParticipant(resource.data.participants) &&
        resource.data.status != 'blocked';
    }

    match /reservedUsernames/{username} {
      allow read: if isAuthenticated();
      allow create: if canCreateReservedUsername(request.resource.data, username);
      allow update: if canUpdateReservedUsername();
      allow delete: if false;
    }

    match /claimCodes/{claimCodeId} {
      // Guest-player/team claim tokens are resolved and consumed only by
      // trusted callables. The remaining client-readable documents are the
      // separate V1 team-invite flow and require exact bearer possession.
      allow get: if isAuthenticated() &&
        resource.data.targetType == 'teamInvite';
      allow list: if isAuthenticated() &&
        resource.data.targetType == 'teamInvite' &&
        resource.data.createdBy == request.auth.uid;
      allow create: if canCreateClaimCode(request.resource.data);
      allow update: if canUpdateClaimCode(resource.data);
      allow delete: if false;
    }

    match /fanVotingSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if false;
      allow delete: if false;
    }

    match /userVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /fantasyLeagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /fantasyRoundSettlements/{markerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /fantasyTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerPlayerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerPlayerId == request.auth.uid &&
        request.resource.data.ownerPlayerId == resource.data.ownerPlayerId;
      allow delete: if false;
    }

    match /fantasySlots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        ownsFantasyTeam(request.resource.data.fantasyTeamId);
      allow delete: if false;
    }

    match /transferRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        ownsFantasyTeam(request.resource.data.fantasyTeamId);
      allow update, delete: if false;
    }

    match /playerFantasyValues/{valueId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Phase 7: Audit & Disputes ──

    match /auditEvents/{eventId} {
      allow read: if canReadAuditEvent(resource.data);
      allow create, update, delete: if false;
    }

    match /userReports/{reportId} {
      allow read, write: if false;
    }

    match /safetyActionQuotas/{actorId} {
      // Trusted callables own anti-abuse counters. Exposing either the actor
      // document or its windows would leak moderation activity.
      allow read, write: if false;
    }

    match /accountDeletionRequests/{requestId} {
      // This tombstone prevents a cached token from reviving safety actions.
      // Account deletion status is exposed only through trusted operations.
      allow read, write: if false;
    }

    match /analyticsEvents/{eventId} {
      // ELR-SEC-105 containment: client telemetry was forgeable and exposed
      // stable activity identifiers. Trusted aggregate ingestion is deferred
      // to ELR-OPS-405, so every client operation fails closed for now.
      allow read, write: if false;
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // ── Catch-all: block any unknown collection ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

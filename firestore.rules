rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return isAuthenticated() && request.auth.uid in participants;
    }

    function isMatchOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function isMatchOrganizerById(matchId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        get(/databases/$(database)/documents/matches/$(matchId))
          .data.organizerId == request.auth.uid;
    }

    function isTournamentOrganizer() {
      return isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    function ownsTeamById(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId))
          .data.ownerId == request.auth.uid;
    }

    function canManageTeamById(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        (
          get(/databases/$(database)/documents/teams/$(teamId))
            .data.ownerId == request.auth.uid ||
          request.auth.uid in
            get(/databases/$(database)/documents/teams/$(teamId))
              .data.viceCaptainIds
        );
    }

    function organizesTournamentById(tournamentId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId))
          .data.organizerId == request.auth.uid;
    }

    function canManageGuestPlayer(data) {
      return isAuthenticated() && (
        (data.createdBy is string && data.createdBy == request.auth.uid) ||
        (data.teamId is string && ownsTeamById(data.teamId)) ||
        (data.tournamentId is string && organizesTournamentById(data.tournamentId))
      );
    }

    function canCreateGuestPlayer(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        (
          (data.teamId is string && ownsTeamById(data.teamId)) ||
          (data.tournamentId is string && organizesTournamentById(data.tournamentId))
        );
    }

    function canManageGuestTeam(data) {
      return isAuthenticated() &&
        data.creatorId is string &&
        data.creatorId == request.auth.uid;
    }

    function ownsGuestTeamById(guestTeamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/guestTeams/$(guestTeamId)) &&
        get(/databases/$(database)/documents/guestTeams/$(guestTeamId))
          .data.creatorId == request.auth.uid;
    }

    function canCreateTournamentRegistration(data) {
      return isAuthenticated() &&
        data.tournamentId is string &&
        (
          organizesTournamentById(data.tournamentId) ||
          (data.teamId is string && ownsTeamById(data.teamId)) ||
          (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId))
        );
    }

    function canUpdateTournamentRegistration(data) {
      return isAuthenticated() &&
        data.tournamentId is string &&
        (
          organizesTournamentById(data.tournamentId) ||
          (data.teamId is string && ownsTeamById(data.teamId)) ||
          (data.guestTeamId is string && ownsGuestTeamById(data.guestTeamId))
        );
    }

    function canManageMatchdaySide(data) {
      return isAuthenticated() &&
        data.matchId is string &&
        (
          (
            data.teamId is string &&
            (
              canManageTeamById(data.teamId) ||
              isMatchOrganizerById(data.matchId)
            )
          ) ||
          (
            data.guestTeamId is string &&
            (
              ownsGuestTeamById(data.guestTeamId) ||
              isMatchOrganizerById(data.matchId)
            )
          )
        );
    }

    function canCreateClaimCode(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        (
          (
            data.targetType == 'guestPlayer' &&
            data.targetId is string &&
            exists(/databases/$(database)/documents/guestPlayers/$(data.targetId)) &&
            canManageGuestPlayer(
              get(/databases/$(database)/documents/guestPlayers/$(data.targetId)).data
            )
          ) ||
          (
            data.targetType == 'guestTeam' &&
            data.targetId is string &&
            exists(/databases/$(database)/documents/guestTeams/$(data.targetId)) &&
            canManageGuestTeam(
              get(/databases/$(database)/documents/guestTeams/$(data.targetId)).data
            )
          ) ||
          (
            data.targetType == 'teamInvite' &&
            data.teamId is string &&
            data.targetId == data.teamId &&
            canManageTeamById(data.teamId)
          )
        );
    }

    function isActiveGuestPlayerClaimCode(claimCode, guestPlayerId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestPlayer' &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestPlayerId &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'active' &&
        (
          !(get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt is int) ||
          get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt > request.time.toMillis()
        );
    }

    function isActiveGuestTeamClaimCode(claimCode, guestTeamId) {
      return claimCode is string &&
        exists(/databases/$(database)/documents/claimCodes/$(claimCode)) &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetType == 'guestTeam' &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.targetId == guestTeamId &&
        get(/databases/$(database)/documents/claimCodes/$(claimCode))
          .data.status == 'active' &&
        (
          !(get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt is int) ||
          get(/databases/$(database)/documents/claimCodes/$(claimCode))
            .data.expiresAt > request.time.toMillis()
        );
    }

    function canSelfClaimGuestPlayer(guestPlayerId) {
      return isAuthenticated() &&
        resource.data.claimCode is string &&
        isActiveGuestPlayerClaimCode(resource.data.claimCode, guestPlayerId) &&
        request.resource.data.displayName == resource.data.displayName &&
        request.resource.data.normalizedName == resource.data.normalizedName &&
        request.resource.data.phoneNumber == resource.data.phoneNumber &&
        request.resource.data.jerseyNumber == resource.data.jerseyNumber &&
        request.resource.data.preferredPosition == resource.data.preferredPosition &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.claimCode == resource.data.claimCode &&
        request.resource.data.notes == resource.data.notes &&
        request.resource.data.claimStatus == 'claimed' &&
        request.resource.data.linkedPlayerId == request.auth.uid;
    }

    function canSelfClaimGuestTeam(guestTeamId) {
      return isAuthenticated() &&
        resource.data.claimCode is string &&
        isActiveGuestTeamClaimCode(resource.data.claimCode, guestTeamId) &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.normalizedName == resource.data.normalizedName &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.contactName == resource.data.contactName &&
        request.resource.data.contactPhone == resource.data.contactPhone &&
        request.resource.data.logoUrl == resource.data.logoUrl &&
        request.resource.data.tournamentIds == resource.data.tournamentIds &&
        request.resource.data.captainGuestPlayerId == resource.data.captainGuestPlayerId &&
        request.resource.data.claimCode == resource.data.claimCode &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.claimStatus == 'claimed' &&
        request.resource.data.linkedTeamId is string &&
        ownsTeamById(request.resource.data.linkedTeamId) &&
        (
          !(get(/databases/$(database)/documents/claimCodes/$(resource.data.claimCode))
            .data.teamId is string) ||
          get(/databases/$(database)/documents/claimCodes/$(resource.data.claimCode))
            .data.teamId == request.resource.data.linkedTeamId
        );
    }

    function canFinalizeGuestPlayerClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestPlayer' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedByPlayerId == request.auth.uid;
    }

    function canRequestGuestTeamClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestTeam' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.status == 'active' &&
        request.resource.data.claimedAt == resource.data.claimedAt &&
        request.resource.data.claimedByPlayerId == request.auth.uid &&
        request.resource.data.teamId is string &&
        ownsTeamById(request.resource.data.teamId) &&
        (
          !(resource.data.teamId is string) ||
          resource.data.teamId == request.resource.data.teamId
        ) &&
        (
          !(resource.data.claimedByPlayerId is string) ||
          resource.data.claimedByPlayerId == request.auth.uid
        );
    }

    function canFinalizeGuestTeamClaimCode() {
      return isAuthenticated() &&
        resource.data.targetType == 'guestTeam' &&
        resource.data.status == 'active' &&
        (
          !(resource.data.expiresAt is int) ||
          resource.data.expiresAt > request.time.toMillis()
        ) &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.scope == resource.data.scope &&
        request.resource.data.tournamentId == resource.data.tournamentId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.requiresApproval == resource.data.requiresApproval &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedAt is int &&
        request.resource.data.teamId is string &&
        (
          (
            ownsTeamById(request.resource.data.teamId) &&
            request.resource.data.claimedByPlayerId == request.auth.uid
          ) ||
          (
            resource.data.createdBy == request.auth.uid &&
            resource.data.teamId is string &&
            resource.data.teamId == request.resource.data.teamId &&
            resource.data.claimedByPlayerId is string &&
            request.resource.data.claimedByPlayerId == resource.data.claimedByPlayerId
          )
        );
    }

    function canSelfClaimMembership() {
      return isAuthenticated() &&
        resource.data.guestPlayerId is string &&
        isActiveGuestPlayerClaimCode(
          get(/databases/$(database)/documents/guestPlayers/$(resource.data.guestPlayerId))
            .data.claimCode,
          resource.data.guestPlayerId
        ) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.playerId == request.auth.uid &&
        request.resource.data.guestPlayerId == null &&
        request.resource.data.claimedFromGuestPlayerId == resource.data.guestPlayerId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.availability == resource.data.availability &&
        request.resource.data.joinedAt == resource.data.joinedAt &&
        request.resource.data.invitedBy == resource.data.invitedBy;
    }

    function canUpdateClaimCode(data) {
      return isAuthenticated() &&
        data.createdBy == request.auth.uid &&
        request.resource.data.targetType == resource.data.targetType &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.createdBy == resource.data.createdBy;
    }

    function ownsFantasyTeam(teamId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/fantasyTeams/$(teamId)) &&
        get(/databases/$(database)/documents/fantasyTeams/$(teamId))
          .data.ownerPlayerId == request.auth.uid;
    }

    function hasValidMatchEventActor(data) {
      return data.actor is map &&
        data.actor.keys().hasOnly([
          'kind',
          'id',
          'displayName',
          'linkedPlayerId'
        ]) &&
        data.actor.kind in ['player', 'guestPlayer', 'matchSidePlayer'] &&
        data.actor.id is string &&
        data.actor.id.size() > 0 &&
        data.actor.displayName is string &&
        data.actor.displayName.size() > 0 &&
        (
          !data.actor.keys().hasAny(['linkedPlayerId']) ||
          data.actor.linkedPlayerId == null ||
          data.actor.linkedPlayerId is string
        );
    }

    function hasValidMatchEventOptionalFields(data) {
      return (
          !data.keys().hasAny(['tournamentId']) ||
          data.tournamentId == null ||
          data.tournamentId is string
        ) &&
        (
          !data.keys().hasAny(['minute']) ||
          data.minute == null ||
          data.minute is int
        );
    }

    function canCreateMatchEvent(data) {
      return isAuthenticated() &&
        data.keys().hasOnly([
          'matchId',
          'tournamentId',
          'eventType',
          'sideKey',
          'actor',
          'minute',
          'createdBy',
          'createdAt',
          'status'
        ]) &&
        data.createdBy == request.auth.uid &&
        data.matchId is string &&
        data.eventType in ['goal', 'mvp'] &&
        data.sideKey in ['A', 'B'] &&
        data.createdAt is int &&
        data.status == 'active' &&
        hasValidMatchEventActor(data) &&
        hasValidMatchEventOptionalFields(data);
    }

    function canVoidMatchEvent() {
      return isAuthenticated() &&
        resource.data.createdBy == request.auth.uid &&
        resource.data.status == 'active' &&
        request.resource.data.status == 'voided' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']);
    }

    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(playerId);
      allow update: if isOwner(playerId);
      allow delete: if false;
    }

    match /guestPlayers/{guestPlayerId} {
      allow read: if isAuthenticated();
      allow create: if canCreateGuestPlayer(request.resource.data);
      allow update: if (
        canManageGuestPlayer(resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy
      ) || canSelfClaimGuestPlayer(guestPlayerId);
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    match /teamMemberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId);
      allow update: if (
        isAuthenticated() &&
        canManageTeamById(resource.data.teamId) &&
        request.resource.data.teamId == resource.data.teamId
      ) || canSelfClaimMembership();
      allow delete: if false;
    }

    match /teamFormationTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId);
      allow update: if isAuthenticated() &&
        canManageTeamById(resource.data.teamId) &&
        request.resource.data.teamId == resource.data.teamId;
      allow delete: if isAuthenticated() &&
        canManageTeamById(resource.data.teamId);
    }

    match /teamRosterSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        canManageTeamById(request.resource.data.teamId);
      allow update, delete: if false;
    }

    match /guestTeams/{guestTeamId} {
      allow read: if isAuthenticated();
      allow create: if canManageGuestTeam(request.resource.data);
      allow update: if (
        canManageGuestTeam(resource.data) &&
        request.resource.data.creatorId == resource.data.creatorId
      ) || canSelfClaimGuestTeam(guestTeamId);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.organizerId == request.auth.uid;
      allow update: if isMatchOrganizer();
      allow delete: if false;

      match /player_stats/{playerId} {
        allow read: if isAuthenticated();
        allow create, update: if isMatchOrganizerById(matchId);
        allow delete: if false;
      }
    }

    match /matchEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if canCreateMatchEvent(request.resource.data);
      allow update: if canVoidMatchEvent();
      allow delete: if false;
    }

    match /matchCheckIns/{checkInId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update: if (
        canManageMatchdaySide(resource.data) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.guestTeamId == resource.data.guestTeamId
      );
      allow delete: if false;
    }

    match /matchAttendances/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update: if (
        canManageMatchdaySide(resource.data) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.guestTeamId == resource.data.guestTeamId
      );
      allow delete: if false;
    }

    match /matchLineupSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update, delete: if false;
    }

    match /matchSubstitutions/{substitutionId} {
      allow read: if isAuthenticated();
      allow create: if canManageMatchdaySide(request.resource.data);
      allow update, delete: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.organizerId == request.auth.uid;
      allow update: if isTournamentOrganizer();
      allow delete: if false;
    }

    match /tournamentRegistrations/{registrationId} {
      allow read: if isAuthenticated();
      allow create: if canCreateTournamentRegistration(request.resource.data);
      allow update: if (
        canUpdateTournamentRegistration(resource.data) &&
        request.resource.data.tournamentId == resource.data.tournamentId
      );
      allow delete: if false;
    }

    match /ratingEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /encounterLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /organizerActions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isAuthenticated();
      allow create: if isParticipant(request.resource.data.participants);
      allow update, delete: if isParticipant(resource.data.participants);
    }

    match /reservedUsernames/{username} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.previousOwnerId == request.auth.uid
      );
      allow delete: if false;
    }

    match /claimCodes/{claimCodeId} {
      allow read: if isAuthenticated();
      allow create: if canCreateClaimCode(request.resource.data);
      allow update: if canUpdateClaimCode(resource.data) ||
        canFinalizeGuestPlayerClaimCode() ||
        canRequestGuestTeamClaimCode() ||
        canFinalizeGuestTeamClaimCode();
      allow delete: if false;
    }

    match /fanVotingSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isMatchOrganizerById(sessionId);
      allow delete: if false;
    }

    match /userVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /fantasyLeagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /fantasyRoundSettlements/{markerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /fantasyTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerPlayerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ownerPlayerId == request.auth.uid &&
        request.resource.data.ownerPlayerId == resource.data.ownerPlayerId;
      allow delete: if false;
    }

    match /fantasySlots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        ownsFantasyTeam(request.resource.data.fantasyTeamId);
      allow delete: if false;
    }

    match /transferRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        ownsFantasyTeam(request.resource.data.fantasyTeamId);
      allow update, delete: if false;
    }

    match /playerFantasyValues/{valueId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Phase 7: Audit & Disputes ──

    match /auditEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'entityType',
          'entityId',
          'action',
          'actorId',
          'beforePayload',
          'afterPayload',
          'metadata',
          'createdAt'
        ]) &&
        request.resource.data.entityType is string &&
        request.resource.data.entityId is string &&
        request.resource.data.action is string &&
        request.resource.data.actorId is string &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.createdAt is int &&
        (
          !request.resource.data.keys().hasAny(['beforePayload']) ||
          request.resource.data.beforePayload is map
        ) &&
        (
          !request.resource.data.keys().hasAny(['afterPayload']) ||
          request.resource.data.afterPayload is map
        ) &&
        (
          !request.resource.data.keys().hasAny(['metadata']) ||
          request.resource.data.metadata is map
        );
      allow update, delete: if false;
    }

    match /analyticsEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if request.resource.data.keys().hasOnly([
          'eventName',
          'actorId',
          'parameters',
          'createdAt'
        ]) &&
        request.resource.data.eventName is string &&
        request.resource.data.createdAt is int &&
        (
          !request.resource.data.keys().hasAny(['parameters']) ||
          request.resource.data.parameters is map
        ) &&
        (
          !request.resource.data.keys().hasAny(['actorId']) ||
          (
            request.resource.data.actorId is string &&
            isAuthenticated() &&
            request.resource.data.actorId == request.auth.uid
          )
        );
      allow update, delete: if false;
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated();
      // Players can create disputes on their own matches
      allow create: if isAuthenticated() &&
        request.resource.data.raisedBy == request.auth.uid &&
        request.resource.data.matchId is string;
      // Only the tournament organizer can resolve/reject
      allow update: if isAuthenticated() &&
        resource.data.matchId is string &&
        isMatchOrganizerById(resource.data.matchId) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.raisedBy == resource.data.raisedBy &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // ── Catch-all: block any unknown collection ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

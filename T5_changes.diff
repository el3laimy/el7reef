+        onStartWithoutLineup: () async {
+          Get.back();
+          await controller.startMatch();
+        },
+        onCreateLineup: (side) async {
+          Get.back();
+          await Get.toNamed(_lineupRouteForSide(side));
+          await controller.refresh();
+        },
+      ),

{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "el7reef-app",
          "appId": "1:876861689777:android:0d2a83f5ba8026f0c7f790",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "el7reef-app",
          "configurations": {
            "android": "1:876861689777:android:0d2a83f5ba8026f0c7f790"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/delete-account",
        "destination": "/delete-account.html"
      },
      {
        "source": "/community-guidelines",
        "destination": "/community-guidelines.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "El7reef",
        "supportEmail": "jitly9@gmail.com"
      }
    }
  },
  "remoteconfig": {
    "template": "remote_config.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
